J.animTocando = nil

local function tocarAnim(id)
    local num = tostring(id):match("%d+")
    if not num then P.aviso("id invalido", "erro"); return end
    local h = humano()
    if not h then P.aviso("personagem nao carregou", "erro"); return end

    if J.animTocando then pcall(function() J.animTocando:Stop() end) end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. num
    local ok, faixa = pcall(function()
        local carregador = h:FindFirstChildOfClass("Animator") or h
        return carregador:LoadAnimation(anim)
    end)
    if not ok or not faixa then P.aviso("o jogo recusou essa animacao", "erro", 5); return end
    pcall(function()
        faixa.Priority = Enum.AnimationPriority.Action4
        faixa.Looped   = S.animLoop
        faixa:Play()
        faixa:AdjustSpeed(S.velAnim)
    end)
    J.animTocando = faixa
    P.aviso("tocando animacao " .. num, "ok")
end

local function pararAnim()
    if J.animTocando then pcall(function() J.animTocando:Stop() end); J.animTocando = nil end
    for _, f in ipairs(faixasTocando()) do pcall(function() f:Stop() end) end
    P.aviso("animacoes paradas", "ok")
end

