-- Character Recovery: se o personagem sumir e nao voltar, pede respawn
Ciclos.coracao["recuperar"] = function()
    if not S.autoRecuperar then return end
    if tick() - (Pro.checouEm or 0) < 3 then return end
    Pro.checouEm = tick()

    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if (not c) or (not c.Parent) or (not h) then
        Pro.semPersonagem = (Pro.semPersonagem or 0) + 1
        if Pro.semPersonagem >= 3 then
            Pro.semPersonagem = 0
            anotar("personagem sumiu, pedi respawn")
            P.aviso("seu personagem sumiu, pedindo respawn", "atencao", 4)
            pcall(function() LP:LoadCharacter() end)
        end
    else
        Pro.semPersonagem = 0
        if S.autoRespawn and h.Health <= 0 then
            if tick() - (Pro.morreuEm or 0) > 6 then
                Pro.morreuEm = tick()
                task.delay(S.respawnEspera, function()
                    if humano() and humano().Health <= 0 then
                        pcall(function() LP:LoadCharacter() end)
                    end
                end)
            end
        end
    end
end

