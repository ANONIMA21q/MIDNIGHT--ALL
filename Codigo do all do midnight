    -- de proposito nao marco como visitado: voltar pra ca e o objetivo
    P.aviso("voltando pro mesmo servidor...", "ok", 6)
    local ok = pcall(function()
        Svc.Teleport:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP)
    end)
    if not ok then
        pcall(function() Svc.Teleport:Teleport(game.PlaceId, LP) end)
