--==========================================================================
-- VIGIA DE PROPRIEDADES  (Property Watcher / State Protector)
--==========================================================================
-- Roda sempre, mas so age no que voce ligou. Cada bloco e um "anti" da lista.
Ciclos.coracao["vigia"] = function()
    local h, r = humano(), raiz()
    if not h then return end

    ---------------------------------------------------------- velocidade e pulo
    -- Anti Speed Reset / Auto Restore WalkSpeed
    if S.antiSpeedReset and Pro.guardado.walk then
        -- so devolve se VOCE nao estiver mandando na velocidade pela aba MOVIMENTO
        if not S.veloc and h.WalkSpeed ~= Pro.guardado.walk then
            if h.WalkSpeed < Pro.guardado.walk - 0.5 then
                h.WalkSpeed = Pro.guardado.walk
                anotar("devolveram sua velocidade (estava " .. tostring(math.floor(h.WalkSpeed)) .. ")")
            end
        end
    end

    -- Anti Slow: qualquer coisa abaixo do minimo volta
    if S.antiSlow and not S.veloc then
        if h.WalkSpeed < S.velocMinima then
            h.WalkSpeed = S.velocMinima
            anotar("tentaram te deixar lento")
        end
    end

    -- Auto Restore JumpPower / Anti Jump Disable
    if S.antiJumpBlock and not S.pulo then
        if h.UseJumpPower then
            if Pro.guardado.jumpP and h.JumpPower < 1 then
                h.JumpPower = Pro.guardado.jumpP
                anotar("desbloquearam seu pulo")
            end
        else
            if Pro.guardado.jumpH and h.JumpHeight < 0.2 then
                h.JumpHeight = Pro.guardado.jumpH
                anotar("desbloquearam seu pulo")
            end
        end
        if not h:GetStateEnabled(Enum.HumanoidStateType.Jumping) then
            h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            anotar("religaram o estado de pulo")
        end
    end

    ---------------------------------------------------------- estados do humanoid
    -- Anti Ragdoll / Anti Stun / Anti PlatformStand / Anti Freeze
    if S.antiRagdoll then
        h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        if h:GetState() == Enum.HumanoidStateType.Ragdoll
           or h:GetState() == Enum.HumanoidStateType.FallingDown then
            h:ChangeState(Enum.HumanoidStateType.GettingUp)
            anotar("te derrubaram, levantei voce")
        end
    end

    if S.antiPlatform and not S.fly then
        if h.PlatformStand then
            h.PlatformStand = false
            anotar("te travaram de pe (platform stand)")
        end
    end

    -- Anti Sit
    if S.antiSit and h.Sit then
        h.Sit = false
        anotar("te sentaram a forca")
    end

    -- Anti Freeze / Anti Anchored
    if S.antiAnchor and r and r.Anchored and not S.freecam then
        r.Anchored = false
        anotar("te congelaram no lugar")
    end

    -- Anti Collision: alguem tirou sua colisao pra te fazer cair pelo mapa
    if S.antiColisao and not S.noclip and r then
        if not r.CanCollide then
            -- a raiz normalmente e sem colisao mesmo; olho as pernas
            local perna = pers() and (pers():FindFirstChild("Left Leg")
                          or pers():FindFirstChild("LeftFoot")
                          or pers():FindFirstChild("Torso")
                          or pers():FindFirstChild("UpperTorso"))
            if perna and perna:IsA("BasePart") and not perna.CanCollide then
                perna.CanCollide = true
                anotar("devolveram sua colisao")
            end
        end
    end

    ---------------------------------------------------------- gravidade
    if S.antiGravidade and not S.gravidade then
        local bom = Pro.guardado.gravity or 196.2
        if math.abs(workspace.Gravity - bom) > 1 then
            workspace.Gravity = bom
            anotar("mexeram na gravidade")
        end
    end

    ---------------------------------------------------------- fisica: fling e empurrao
    if r then
        local v = r.AssemblyLinearVelocity
        local a = r.AssemblyAngularVelocity

        -- Anti Fling: giro absurdo e o que te arremessa
        if S.antiFling then
            if a.Magnitude > S.flingGiro then
                r.AssemblyAngularVelocity = Vector3.zero
                anotar(("giro de %d parado"):format(math.floor(a.Magnitude)))
            end
            if v.Magnitude > S.flingVel then
                r.AssemblyLinearVelocity = v.Unit * 40
                anotar(("arremesso de %d freado"):format(math.floor(v.Magnitude)))
            end
        end

        -- Anti Knockback: empurrao subito na horizontal
        if S.antiKnockback then
            local dif = (v - Pro.velAnterior)
            local difH = Vector3.new(dif.X, 0, dif.Z)
            if difH.Magnitude > S.knockLimite then
                r.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
                anotar(("empurrao de %d anulado"):format(math.floor(difH.Magnitude)))
            end
        end
        Pro.velAnterior = v

        ---------------------------------------------------------- void e queda
        local h2 = humano()
        if h2 and h2.FloorMaterial ~= Enum.Material.Air and r.Position.Y > S.voidAltura + 20 then
            Pro.chaoSeguro = r.Position
        end

        -- Anti Void
        if S.antiVoid and r.Position.Y < S.voidAltura then
            if Pro.chaoSeguro then
                r.CFrame = CFrame.new(Pro.chaoSeguro + Vector3.new(0, 4, 0))
                r.AssemblyLinearVelocity = Vector3.zero
                anotar("voce caiu no void, te trouxe de volta")
            end
        end

        -- Anti Fall: freia a queda antes de bater no chao
        if S.antiFall and v.Y < -S.quedaLimite then
            r.AssemblyLinearVelocity = Vector3.new(v.X, -S.quedaLimite * 0.35, v.Z)
        end
    end
end

--==========================================================================
-- SMART ANTI FLING  (olha os outros players e reage antes)
--==========================================================================
Ciclos.coracao["antiFlingEsperto"] = function()
    if not S.antiFlingEsperto then return end
    local r = raiz()
    if not r then return end

    for _, p in ipairs(Svc.Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
                     or p.Character.PrimaryPart
            if pr then
                local dist = (pr.Position - r.Position).Magnitude
                local vel  = pr.AssemblyLinearVelocity.Magnitude
                local giro = pr.AssemblyAngularVelocity.Magnitude
                -- alguem girando feito helice ou vindo em alta a menos de 25m
                if dist < 25 and (giro > 60 or vel > 180) then
                    if Pro.ultimoAlvo ~= p or tick() - (Pro.avisadoEm or 0) > 4 then
                        Pro.ultimoAlvo = p
                        Pro.avisadoEm  = tick()
                        anotar("cuidado: " .. p.DisplayName .. " veio pra te flingar")
                        P.aviso("perigo: " .. p.DisplayName .. " girando perto de voce", "atencao", 3)
                    end
                    -- blindagem temporaria
                    r.AssemblyAngularVelocity = Vector3.zero
                    if r.AssemblyLinearVelocity.Magnitude > 80 then
                        r.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
    end
end

