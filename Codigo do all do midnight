end)

--==========================================================================
-- 2 · BOLHA  (ninguem encosta em voce)
--==========================================================================
-- Cria uma parede invisivel em volta de voce. Como a colisao e do SEU lado,
-- os outros nao conseguem te empurrar, te prensar nem te grudar.
local function ligarBolha(on)
    Ciclos.coracao["bolha"] = nil
    local velha = workspace:FindFirstChild("MN_Bolha")
    if velha then pcall(function() velha:Destroy() end) end
    if not on then return end

    local b = Instance.new("Part")
    b.Name         = "MN_Bolha"
    b.Shape        = Enum.PartType.Ball
    b.Size         = Vector3.new(S.bolhaRaio, S.bolhaRaio, S.bolhaRaio)
    b.Anchored     = true
    b.CanCollide   = true
    b.CanQuery     = false
    b.Transparency = S.bolhaVisivel and 0.75 or 1
    b.Material     = Enum.Material.ForceField
    b.Color        = cor()
    b.Parent       = workspace

    Ciclos.coracao["bolha"] = function()
        if not S.bolha then return end
        local r = raiz()
        if not (r and b.Parent) then return end
        b.Size     = Vector3.new(S.bolhaRaio, S.bolhaRaio, S.bolhaRaio)
        b.Position = r.Position
        b.Transparency = S.bolhaVisivel and 0.75 or 1
        b.Color    = cor()
    end
    P.aviso("bolha ligada - ninguem encosta em voce", "ok", 4)
end

--==========================================================================
-- 3 · DETECTOR DE MAO PESADA  (quem esta encostando em voce e por quanto tempo)
--==========================================================================
-- Serve pra pegar quem fica grudado, quem te empurra pra dentro de parede
-- e quem esta tentando te prensar. Mostra o nome e o tempo.
Ciclos.coracao["encostou"] = function()
    if not S.detectarToque then return end
    if tick() - (Pro2.checouToque or 0) < 0.3 then return end
    Pro2.checouToque = tick()

    local r = raiz()
    if not r then return end

    for _, p in ipairs(Svc.Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
                     or p.Character.PrimaryPart
            if pr then
                local d = (pr.Position - r.Position).Magnitude
                if d < S.toqueRaio then
                    Pro2.tocando[p] = (Pro2.tocando[p] or 0) + 0.3
                    if Pro2.tocando[p] > S.toqueTempo then
                        Pro2.tocando[p] = 0
                        local msg = ("%s esta colado em voce ha %ds")
                            :format(p.DisplayName, math.floor(S.toqueTempo))
                        P.aviso(msg, "atencao", 4)
                        anotar(msg)
                        if S.toqueFugir then
                            local fuga = (r.Position - pr.Position)
                            if fuga.Magnitude < 1 then fuga = Vector3.new(1, 0, 0) end
                            r.CFrame = CFrame.new(r.Position + fuga.Unit * 25 + Vector3.new(0, 5, 0))
                            anotar("fugi de " .. p.DisplayName)
                        end
                    end
                else
                    Pro2.tocando[p] = 0
                end
            end
        end
    end
end

--==========================================================================
-- 4 · ISCA  (deixa um clone parado e some de verdade)
--==========================================================================
-- Voce fica invisivel e sem colisao, e um clone seu fica no lugar. Quem vier
-- te flingar ou te seguir vai no clone. So voce sabe onde voce esta.
local function tirarIsca()
    if Pro2.clone then pcall(function() Pro2.clone:Destroy() end); Pro2.clone = nil end
    local c = pers()
    if c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") or p:IsA("Decal") then
                pcall(function() p.LocalTransparencyModifier = 0 end)
            end
        end
    end
    Pro2.escondido = false
end

local function ligarIsca(on)
    if not on then tirarIsca(); return end

    local c, r = pers(), raiz()
    if not (c and r) then P.aviso("personagem nao carregou", "erro"); return end

    tirarIsca()

    -- clone parado no lugar
    local ok, clone = pcall(function()
        local cl = c:Clone()
        cl.Name = "MN_Isca"
        for _, d in ipairs(cl:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end
            if d:IsA("BasePart") then d.Anchored = true; d.CanCollide = false end
            if d:IsA("Humanoid") then
                d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            end
        end
        cl.Parent = workspace
        return cl
    end)
    if ok and clone then Pro2.clone = clone end

    -- voce some da SUA tela e atravessa tudo
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") or p:IsA("Decal") then
            pcall(function() p.LocalTransparencyModifier = 0.85 end)
        end
    end
    Pro2.escondido = true

    P.aviso("isca criada - ela fica, voce sai andando", "ok", 5)
    anotar("deixei uma isca no lugar")
end

