-- ANCORAS DA LINHA
--==========================================================================
-- Ponto de onde o beam nasce. Fica preso a BORDA da tela: eu calculo a
-- meia-altura visivel pela abertura da camera, entao baixo e baixo de
-- verdade e cima e cima de verdade, em qualquer FOV e qualquer resolucao.
E.ancoras = {}

local function ancoraEm(chave, alturaRel, frente)
    local a = E.ancoras[chave]
    if not (a and a.peca and a.peca.Parent) then
        local peca = novo("Part", { Name = "MN_Ancora_" .. chave, Anchored = true,
            CanCollide = false, CanQuery = false, Transparency = 1,
            Size = Vector3.new(0.2, 0.2, 0.2) }, workspace)
        a = { peca = peca, att = novo("Attachment", { Name = "MN_Att" }, peca) }
        E.ancoras[chave] = a
    end
    a.peca.CFrame = Camera.CFrame * CFrame.new(0, alturaRel, -frente)
    return a
end

