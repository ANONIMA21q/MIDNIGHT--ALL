local function raizDe(p)
    local c = p and p.Character
    return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart) or nil
end
local function humDe(p)
    local c = p and p.Character
    return c and c:FindFirstChildOfClass("Humanoid") or nil
end
local function distDe(p)
    local r = raizDe(p)
    if not r then return -1 end
    return math.floor((r.Position - U.myPos()).Magnitude)
end
local function outros()
    local t = {}
    for _, p in ipairs(Svc.Players:GetPlayers()) do
        if p ~= LP and not J.ignorados[p.Name] then t[#t + 1] = p end
    end
    return t
end

