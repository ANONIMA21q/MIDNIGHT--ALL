-- P.cartao(pg, "Voo", "✈", "fly")  -> devolve o corpo onde entram os controles
function P.cartao(pg, titulo, icone, campoChave, fnChave)
    pg.nCartoes = pg.nCartoes + 1
    -- alterna entre a coluna da esquerda e a da direita
    local col = (pg.nCartoes % 2 == 1) and pg.esq or pg.dir

    -- Na referencia o cartao NAO tem contorno: e so um bloco escuro com a
    -- faixa do cabecalho um pouco MAIS CLARA que o corpo, tudo colado.
    local cartao = Instance.new("Frame")
    cartao.Name, cartao.Size = "Cartao", UDim2.new(1, 0, 0, 0)
    cartao.AutomaticSize = Enum.AutomaticSize.Y
    cartao.BackgroundColor3, cartao.BackgroundTransparency = T.fundo2, 0
    cartao.BorderSizePixel, cartao.LayoutOrder = 0, pg.nCartoes
    cartao.ClipsDescendants, cartao.Parent = true, col
    canto(cartao, 8)
    vidrar(cartao, 0)

    -- cabecalho: faixa mais clara, colada no topo
    local cab = Instance.new("Frame")
    cab.Size, cab.BackgroundColor3 = UDim2.new(1, 0, 0, 44), T.fundo3
    cab.BackgroundTransparency, cab.BorderSizePixel, cab.Parent = 0, 0, cartao
    canto(cab, 8)
    vidrar(cab, 0)

    -- tapa os cantos de baixo do cabecalho pra ele colar no corpo
    local colar = Instance.new("Frame")
    colar.Size, colar.Position = UDim2.new(1, 0, 0, 10), UDim2.new(0, 0, 1, -10)
    colar.BackgroundColor3, colar.BackgroundTransparency = T.fundo3, 0
    colar.BorderSizePixel, colar.Parent = 0, cab
    vidrar(colar, 0)

    -- icone dentro de um quadradinho arredondado, como na foto
    local cxIc = Instance.new("Frame")
    cxIc.Size, cxIc.Position = UDim2.new(0, 26, 0, 26), UDim2.new(0, 11, 0.5, -13)
    cxIc.BackgroundColor3, cxIc.BackgroundTransparency = cor(), 0.82
    cxIc.BorderSizePixel, cxIc.Name, cxIc.Parent = 0, "CaixaIcone", cab
    canto(cxIc, 7)

    local ic = Instance.new("TextLabel")
    ic.Size, ic.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    ic.Font, ic.TextSize, ic.TextColor3 = Enum.Font.GothamBold, 13, cor()
    ic.Text, ic.Name, ic.Parent = icone or "•", "IconeCartao", cxIc

    local tt = Instance.new("TextLabel")
    tt.Size, tt.Position = UDim2.new(1, -100, 1, 0), UDim2.new(0, 46, 0, 0)
    tt.BackgroundTransparency, tt.Font, tt.TextSize = 1, Enum.Font.GothamBold, 12
    tt.TextColor3, tt.TextXAlignment = T.texto, Enum.TextXAlignment.Left
    tt.Text, tt.Parent = titulo, cab

    -- chave do cartao inteiro (canto direito, como na referencia)
    if campoChave then
        local trilho = Instance.new("Frame")
        trilho.Size, trilho.Position = UDim2.new(0, 34, 0, 18), UDim2.new(1, -46, 0.5, -9)
        trilho.BackgroundColor3, trilho.BorderSizePixel = Color3.fromRGB(56, 56, 70), 0
        trilho.ZIndex, trilho.Parent = 2, cab
        canto(trilho, 9)

        local bola = Instance.new("Frame")
        bola.Size, bola.Position = UDim2.new(0, 14, 0, 14), UDim2.new(0, 2, 0.5, -7)
        bola.BackgroundColor3, bola.BorderSizePixel = Color3.fromRGB(155, 155, 170), 0
        bola.ZIndex, bola.Parent = 3, trilho
        canto(bola, 7)

        local toque = Instance.new("TextButton")
        toque.Size, toque.Position = UDim2.new(0, 46, 0, 32), UDim2.new(1, -52, 0.5, -16)
        toque.BackgroundTransparency, toque.Text = 1, ""
        toque.ZIndex, toque.Parent = 4, cab

        local function pintar(on)
            local ti = TweenInfo.new(0.13, Enum.EasingStyle.Quad)
            Svc.Tween:Create(trilho, ti, {
                BackgroundColor3 = on and cor() or Color3.fromRGB(56, 56, 70) }):Play()
            Svc.Tween:Create(bola, ti, {
                Position = on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(155, 155, 170) }):Play()
        end
        pintar(S[campoChave] and true or false)
        registrarChave(campoChave, pintar)

        toque.MouseButton1Click:Connect(function()
            local v = not (S[campoChave] and true or false)
            S[campoChave] = v
            pintar(v)
            if fnChave then
                local ok, err = pcall(fnChave, v)
                if not ok then P.aviso("erro em " .. titulo .. ": " .. tostring(err), "erro", 6) end
            end
        end)
    end

    -- corpo: onde os controles entram
    local corpo = Instance.new("Frame")
    corpo.Name, corpo.Size = "Corpo", UDim2.new(1, -20, 0, 0)
    corpo.Position, corpo.BackgroundTransparency = UDim2.new(0, 10, 0, 44), 1
    corpo.AutomaticSize, corpo.Parent = Enum.AutomaticSize.Y, cartao

    local lay = Instance.new("UIListLayout")
    lay.Padding, lay.SortOrder = UDim.new(0, 5), Enum.SortOrder.LayoutOrder
    lay.Parent = corpo

    local pad = Instance.new("UIPadding")
    pad.PaddingBottom = UDim.new(0, 12)
    pad.Parent = corpo

    pg.cartoes[#pg.cartoes + 1] = { cartao = cartao, titulo = titulo, corpo = corpo }
    return corpo
end

