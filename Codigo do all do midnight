-- ABAS
--==========================================================================
function P.mostrar(nome)
    for n, pg in pairs(P.pags) do pg.frame.Visible = (n == nome) end
    for n, bt in pairs(P.abas) do
        local ativo = (n == nome)
        -- ativo = faixa translucida na cor do tema + barrinha na esquerda
        bt.BackgroundColor3       = cor()
        bt.BackgroundTransparency = ativo and 0.78 or 1
        local marca = bt:FindFirstChild("Marca")
        if marca then marca.BackgroundTransparency = ativo and 0 or 1 end
        local rot = bt:FindFirstChild("Rotulo")
        if rot then rot.TextColor3 = ativo and T.texto or T.apagado end
        local ic = bt:FindFirstChild("Icone")
        if ic then ic.TextColor3 = ativo and cor() or T.apagado end
    end
    P.atual = nome
    SubMarca.Text = "universal · " .. string.lower(nome)
end

-- P.aba("MOVIMENTO", "Personagem", "✈")
function P.aba(nome, grupo, icone)
