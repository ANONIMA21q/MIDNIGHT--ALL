-- RADAR
--==========================================================================
local Radar, RadarPontos = nil, {}

local function tirarRadar()
    Ciclos.quadro["radar"] = nil
    if Radar then pcall(function() Radar:Destroy() end); Radar = nil end
    RadarPontos = {}
end

local function ligarRadar(on)
    tirarRadar()
    if not on then return end

    Radar = novo("Frame", { Name = "MN_Radar",
        Size = UDim2.new(0, S.radarTam, 0, S.radarTam),
        Position = UDim2.new(1, -S.radarTam - 20, 0, 70),
        BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.3,
        BorderSizePixel = 0, Active = true, Draggable = true }, P.Tela)
    novo("UICorner", { CornerRadius = UDim.new(1, 0) }, Radar)
    local bordaR = novo("UIStroke", { Color = cor(), Thickness = 1.5,
        Transparency = 0.3 }, Radar)
    novo("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(55, 55, 66), BorderSizePixel = 0 }, Radar)
    novo("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(0.5, 0, 0, 0),
        BackgroundColor3 = Color3.fromRGB(55, 55, 66), BorderSizePixel = 0 }, Radar)
    local eu = novo("Frame", { Size = UDim2.new(0, 7, 0, 7),
        Position = UDim2.new(0.5, -3.5, 0.5, -3.5), BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, ZIndex = 3 }, Radar)
    novo("UICorner", { CornerRadius = UDim.new(1, 0) }, eu)

    Ciclos.quadro["radar"] = function()
        if not (S.radar and Radar and Radar.Parent) then return end
        Radar.Size   = UDim2.new(0, S.radarTam, 0, S.radarTam)
        bordaR.Color = cor()

        local r = raiz()
        if not r then return end
        local meio, vistos = S.radarTam * 0.5, {}

        for _, p in ipairs(Svc.Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local pr = p.Character:FindFirstChild("HumanoidRootPart")
                local h  = p.Character:FindFirstChildOfClass("Humanoid")
                if pr then
                    local delta = pr.Position - r.Position
                    local dist  = delta.Magnitude
                    if dist <= S.radarAlcance then
                        vistos[p] = true
                        local pt = RadarPontos[p]
                        if not pt then
                            pt = novo("Frame", { Size = UDim2.new(0, 7, 0, 7),
                                BorderSizePixel = 0, ZIndex = 2 }, Radar)
                            novo("UICorner", { CornerRadius = UDim.new(1, 0) }, pt)
                            RadarPontos[p] = pt
                        end
                        local dx, dz = delta.X, delta.Z
                        if S.radarGira then
                            local cam = Camera.CFrame.LookVector
                            local ang = math.atan2(cam.X, cam.Z)
                            local co, si = math.cos(-ang), math.sin(-ang)
                            dx, dz = dx * co - dz * si, dx * si + dz * co
                        end
                        local esc = meio / S.radarAlcance
                        pt.Position = UDim2.new(0, meio + dx * esc - 3.5,
                                                0, meio + dz * esc - 3.5)
                        local vmax = (h and h.MaxHealth > 0) and h.MaxHealth or 100
                        pt.BackgroundColor3 = corDoAlvo({ dist = dist,
                            vidaFrac = h and (h.Health / vmax) or 1,
                            mesmoTime = mesmoTime(p), visivel = true, deslocamento = 0 })
                    end
                end
            end
        end
        for p, pt in pairs(RadarPontos) do
            if not vistos[p] then pcall(function() pt:Destroy() end); RadarPontos[p] = nil end
        end
    end
end

