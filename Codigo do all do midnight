-- ordem: "Asc" = comeca pelos mais vazios, "Desc" = pelos mais cheios
local function buscarServidores(ordem, paginas)
    local lista, cursor = {}, nil
    for _ = 1, (paginas or 3) do
        local url = ("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=%s&limit=100")
            :format(tostring(game.PlaceId), ordem or "Desc")
        if cursor then url = url .. "&cursor=" .. cursor end

        local dados = U.httpJson(url)
        if not dados then
            return lista, "seu executor nao consegue acessar a lista de servidores"
        end
        if dados.errors then
            return lista, "o Roblox recusou o pedido (tente de novo em alguns segundos)"
        end
        if dados.data then
            for _, s in ipairs(dados.data) do lista[#lista + 1] = s end
        end
        cursor = dados.nextPageCursor
        if not cursor then break end
        task.wait(0.35)
    end
    return lista
end

-- filtra pelos seus criterios e ordena
local function escolherCandidatos(lista, preferirVazio)
    local bons = {}
    for _, s in ipairs(lista) do
        local id   = s.id
        local tem  = tonumber(s.playing) or 0
        local cabe = tonumber(s.maxPlayers) or 0
        if id and id ~= game.JobId and cabe > 0 and tem < cabe then
            if tem >= S.hopMin and tem <= S.hopMax then
                if not (S.hopEvitar and Srv.visitados[id]) then
                    bons[#bons + 1] = { id = id, tem = tem, cabe = cabe,
                                        ping = tonumber(s.ping) or 0 }
                end
            end
        end
    end
    table.sort(bons, function(a, b)
        if preferirVazio then return a.tem < b.tem end
        return a.tem > b.tem
    end)
    return bons
end

local function trocarDeServidor(preferirVazio, mensagem)
    if Srv.buscando then P.aviso("ja estou procurando, calma", "atencao"); return end
    Srv.buscando = true
    P.aviso(mensagem or "procurando servidor...", "atencao", 5)

    task.spawn(function()
        local lista, erro = buscarServidores(preferirVazio and "Asc" or "Desc", 3)
        if erro then
            P.aviso(erro, "erro", 8)
            Srv.buscando = false
            return
        end

        local bons = escolherCandidatos(lista, preferirVazio)

        -- se nao achou nada, afrouxa o filtro de visitados e tenta de novo
        if #bons == 0 and S.hopEvitar then
            P.aviso("so sobraram servidores ja visitados, usando eles", "atencao", 5)
            local guardado = S.hopEvitar
            S.hopEvitar = false
            bons = escolherCandidatos(lista, preferirVazio)
            S.hopEvitar = guardado
        end

        if #bons == 0 then
            P.aviso(("achei %d servidores, nenhum entre %d e %d pessoas")
                :format(#lista, S.hopMin, S.hopMax), "erro", 8)
            Srv.buscando = false
            return
        end

        -- guarda reservas caso o primeiro recuse
        Srv.fila = {}
        for i = 2, math.min(6, #bons) do Srv.fila[#Srv.fila + 1] = bons[i].id end

        local alvo = bons[1]
        entrarEm(alvo.id, ("indo pra um servidor com %d/%d pessoas")
            :format(alvo.tem, alvo.cabe))
    end)
end

