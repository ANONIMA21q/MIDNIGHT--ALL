local TECLAS_PROIBIDAS = {
    [Enum.KeyCode.Unknown] = true,
    [Enum.KeyCode.Escape]  = true,
}

Svc.UIS.InputBegan:Connect(function(input, usado)
    -- 1) modo captura: grava a tecla apertada
    if ouvindoBind then
        local tecla = nil
        if input.UserInputType == Enum.UserInputType.Keyboard then
            tecla = input.KeyCode
        elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
            tecla = input.KeyCode
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            tecla = Enum.KeyCode.Unknown
        end

        if tecla and not TECLAS_PROIBIDAS[tecla] then
            -- tira essa tecla de quem ja usava
            for id, t in pairs(S.binds) do
                if t == tecla.Name and id ~= ouvindoBind.id then S.binds[id] = nil end
            end
            S.binds[ouvindoBind.id] = tecla.Name
            if ouvindoBind.atualizar then ouvindoBind.atualizar() end
            P.aviso("tecla " .. tecla.Name .. " gravada", "ok", 3)
            fecharBind()
        elseif input.KeyCode == Enum.KeyCode.Escape then
            fecharBind()
        end
        return
    end

    -- 2) modo normal: dispara a acao ligada aquela tecla
    if usado then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard
       and input.UserInputType ~= Enum.UserInputType.Gamepad1 then return end

    local nome = input.KeyCode.Name
    for id, t in pairs(S.binds) do
        if t == nome then
            local fn = P.bindAcoes[id]
            if fn then
                local ok, err = pcall(fn)
                if not ok then P.aviso("erro na tecla " .. nome .. ": " .. tostring(err), "erro", 6) end
            end
        end
    end
end)

