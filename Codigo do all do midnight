local function apagar(d)
    for _, k in ipairs({ "brilho","caixaGui","placa","vidaGui","cabecaGui",
                         "linha","linha2","a1" }) do
        if d[k] then pcall(function() d[k]:Destroy() end) end
    end
end

local function esconder(d)
    for _, k in ipairs({ "brilho","caixaGui","placa","vidaGui","cabecaGui",
                         "linha","linha2" }) do
        if d[k] then pcall(function() d[k].Enabled = false end) end
    end
end

function E.limpar()
    for p, d in pairs(E.alvos) do apagar(d); E.alvos[p] = nil end
    for k, a in pairs(E.ancoras) do
        if a.peca then pcall(function() a.peca:Destroy() end) end
        E.ancoras[k] = nil
    end
end

