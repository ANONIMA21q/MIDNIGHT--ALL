    local cAlvo = P.cartao(pg, "Alvo", "◎")
    local topo  = P.quadro(cAlvo, 26)
    local lista = P.lista(cAlvo, 150)

    function J.atualizarTopo()
        topo.set(J.alvo and ("ALVO:  " .. J.alvo.DisplayName .. "   ·   " ..
                 (distDe(J.alvo) >= 0 and (distDe(J.alvo) .. "m") or "?"))
                 or "ALVO:  ninguem escolhido")
    end
    J.atualizarTopo()

    local function mostrarLista()
        lista.limpar()
        local t = outros()
        if #t == 0 then lista.vazia("servidor vazio"); return end
        table.sort(t, function(a, b) return distDe(a) < distDe(b) end)
        for _, p in ipairs(t) do
            local d = distDe(p)
            lista.item(("%s  ·  %s"):format(p.DisplayName, d >= 0 and (d .. "m") or "?"),
                function()
                    J.definirAlvo(J.alvo == p and nil or p)
                    mostrarLista()
