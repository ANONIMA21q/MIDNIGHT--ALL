local function canto(o, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = o; return c
end
local function borda(o, c, esp, tr)
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = c or cor(), esp or 1, tr or 0.5
    s.Parent = o; return s
end
local function margem(o, e, d, c, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft, p.PaddingRight = UDim.new(0, e or 0), UDim.new(0, d or 0)
    p.PaddingTop, p.PaddingBottom = UDim.new(0, c or 0), UDim.new(0, b or 0)
    p.Parent = o; return p
end
local function rolagem(frame, layout, extra)
    local function att()
        frame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + (extra or 16))
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(att)
    task.defer(att)
end

