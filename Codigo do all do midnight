Busca:GetPropertyChangedSignal("Text"):Connect(function()
    local q = string.lower(Busca.Text)
    for _, pg in pairs(P.pags) do
        for _, c in ipairs(pg.cartoes) do
            if q == "" then
                c.cartao.Visible = true
            else
                local achou = string.find(string.lower(c.titulo), q, 1, true) ~= nil
                if not achou then
                    for _, d in ipairs(c.corpo:GetDescendants()) do
                        if d:IsA("TextLabel") or d:IsA("TextButton") then
                            if string.find(string.lower(tostring(d.Text)), q, 1, true) then
                                achou = true; break
                            end
                        end
                    end
                end
                c.cartao.Visible = achou
            end
        end
    end
end)

