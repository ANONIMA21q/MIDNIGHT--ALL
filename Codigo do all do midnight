function P.aviso(msg, tipo, segundos)
    msg = tostring(msg)
    print("[MIDNIGHT] " .. msg)
    local c = T.botao
    if tipo == "ok"      then c = Color3.fromRGB(24, 60, 38) end
    if tipo == "erro"    then c = Color3.fromRGB(68, 26, 30) end
    if tipo == "atencao" then c = Color3.fromRGB(64, 50, 22) end

    local f = Instance.new("Frame")
    f.Size, f.BackgroundColor3, f.BorderSizePixel = UDim2.new(1, 0, 0, 38), c, 0
    f.Parent = Avisos
    pcall(function() f.AutomaticSize = Enum.AutomaticSize.Y end)
    canto(f, 7); borda(f, cor(), 1, 0.7)

    local l = Instance.new("TextLabel")
    l.Size, l.Position = UDim2.new(1, -18, 0, 0), UDim2.new(0, 9, 0, 0)
    l.BackgroundTransparency, l.Font, l.TextSize = 1, Enum.Font.Gotham, 12
    l.TextColor3, l.TextWrapped, l.TextXAlignment = T.texto, true, Enum.TextXAlignment.Left
    l.Text, l.Parent = msg, f
    pcall(function() l.AutomaticSize = Enum.AutomaticSize.Y end)
    margem(l, 0, 0, 8, 8)

    task.delay(segundos or 3.5, function()
        pcall(function()
            Svc.Tween:Create(f, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
            Svc.Tween:Create(l, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
        end)
        task.wait(0.3)
        pcall(function() f:Destroy() end)
    end)
end
