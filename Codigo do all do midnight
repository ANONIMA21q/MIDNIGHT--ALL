local Mov = {}

Mov.cima, Mov.baixo = false, false     -- botoes de subir/descer
Mov.velFly  = Vector3.zero             -- velocidade atual do fly (suavizada)
Mov.velCar  = Vector3.zero             -- idem do fly de carro
Mov.pecas   = {}                       -- BodyVelocity / BodyGyro criados

----------------------------------------------------------------- atalhos
local function pers()  return LP.Character end
local function humano()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid") or nil
end
local function raiz()
    local c = LP.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
end

-- assento em que estou (se estiver num carro)
local function assento()
    local h = humano()
    return h and h.SeatPart or nil
end

-- o veiculo inteiro (modelo) e a peca principal dele
local function veiculo()
    local a = assento()
    if not a then return nil, nil end
    local m = a:FindFirstAncestorWhichIsA("Model")
    if not m then return nil, a end
    local base = m.PrimaryPart or a
    return m, base
end

----------------------------------------------------------------- direcao pela camera
-- Pega o que o joystick (ou WASD) esta pedindo e converte pro eixo da CAMERA,
-- incluindo a inclinacao: olhando pra cima e indo pra frente, sobe.
local function direcaoDesejada(incluirVertical)
    local h = humano()
    local cam = Camera.CFrame

    local frenteChao = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
    local ladoChao   = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
    if frenteChao.Magnitude > 0.001 then frenteChao = frenteChao.Unit end
    if ladoChao.Magnitude   > 0.001 then ladoChao   = ladoChao.Unit end

    local mover = h and h.MoveDirection or Vector3.zero
    local pFrente = mover:Dot(frenteChao)
    local pLado   = mover:Dot(ladoChao)

    local dir = (cam.LookVector * pFrente) + (cam.RightVector * pLado)

    if incluirVertical then
        local v = 0
        if Mov.cima  then v = v + 1 end
        if Mov.baixo then v = v - 1 end
        if Svc.UIS:IsKeyDown(Enum.KeyCode.E)     then v = v + 1 end
        if Svc.UIS:IsKeyDown(Enum.KeyCode.Space) then v = v + 1 end
        if Svc.UIS:IsKeyDown(Enum.KeyCode.Q)     then v = v - 1 end
        dir = dir + Vector3.new(0, v, 0)
    end

    if dir.Magnitude > 1 then dir = dir.Unit end
    return dir
end

----------------------------------------------------------------- FLY
local function pararFly()
    Ciclos.coracao["fly"] = nil
    for nome, obj in pairs(Mov.pecas) do
        if nome == "flyV" or nome == "flyG" then
            pcall(function() obj:Destroy() end)
            Mov.pecas[nome] = nil
        end
    end
    Mov.velFly = Vector3.zero
    local h, r = humano(), raiz()
    if h then pcall(function() h.PlatformStand = false end) end
    if r then
        pcall(function() r.AssemblyLinearVelocity  = Vector3.zero end)
        pcall(function() r.AssemblyAngularVelocity = Vector3.zero end)
    end
end

local function ligarFly()
    pararFly()
    local h, r = humano(), raiz()
    if not (h and r) then P.aviso("personagem ainda nao carregou", "erro"); return end

    pcall(function() h.PlatformStand = true end)

    local bv = Instance.new("BodyVelocity")
    bv.Name     = "MN_FlyV"
    bv.MaxForce = Vector3.new(1, 1, 1) * 9e4
    bv.P        = 1250
    bv.Velocity = Vector3.zero
    bv.Parent   = r

    local bg = Instance.new("BodyGyro")
    bg.Name      = "MN_FlyG"
    bg.MaxTorque = Vector3.new(1, 1, 1) * 9e4
    bg.P         = 9000
    bg.D         = 550
    bg.CFrame    = r.CFrame
    bg.Parent    = r

    Mov.pecas.flyV, Mov.pecas.flyG = bv, bg

    Ciclos.coracao["fly"] = function(dt)
        if not S.fly then return end
        local h2, r2 = humano(), raiz()
        if not (h2 and r2 and bv.Parent and bg.Parent) then return end
        dt = dt or 0.016

        local dir  = direcaoDesejada(true)
        local alvo = dir * S.flyVel

        -- aceleracao e freio suaves: e isso que tira a sensacao de seco
        local peso = S.flySuave
        if dir.Magnitude < 0.01 then peso = S.flyFreio end
        Mov.velFly = Mov.velFly:Lerp(alvo, U.clamp(dt * peso, 0, 1))
        bv.Velocity = Mov.velFly

        -- o corpo vira devagar pra onde a camera olha
        local cam = Camera.CFrame
        local frente = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
        if frente.Magnitude > 0.001 then
            local pos = r2.Position
            bg.CFrame = bg.CFrame:Lerp(CFrame.new(pos, pos + frente.Unit),
                                       U.clamp(dt * 9, 0, 1))
        end
    end
end

----------------------------------------------------------------- FLY DE CARRO
local function pararFlyCarro()
    Ciclos.coracao["flycar"] = nil
    for nome, obj in pairs(Mov.pecas) do
        if nome == "carV" or nome == "carG" then
            pcall(function() obj:Destroy() end)
            Mov.pecas[nome] = nil
        end
    end
    Mov.velCar = Vector3.zero
end

local function ligarFlyCarro()
    pararFlyCarro()
    local m, base = veiculo()
    if not base then
        P.aviso("entre num carro antes de ligar", "atencao", 5)
        P.setChave("flyCarro", false)
        return false
    end

    -- solta as rodas do chao pra nao brigar com a suspensao
    if m and S.carroSemColisao then
        for _, p in ipairs(m:GetDescendants()) do
            if p:IsA("BasePart") and not p:IsA("VehicleSeat") and not p:IsA("Seat") then
                pcall(function() p.CanCollide = false end)
            end
        end
    end

    local bv = Instance.new("BodyVelocity")
    bv.Name     = "MN_CarV"
    bv.MaxForce = Vector3.new(1, 1, 1) * 9e6
    bv.P        = 3000
    bv.Velocity = Vector3.zero
    bv.Parent   = base

    local bg = Instance.new("BodyGyro")
    bg.Name      = "MN_CarG"
    bg.MaxTorque = Vector3.new(1, 1, 1) * 9e6
    bg.P         = 9000
    bg.D         = 700
    bg.CFrame    = base.CFrame
    bg.Parent    = base

    Mov.pecas.carV, Mov.pecas.carG = bv, bg

    Ciclos.coracao["flycar"] = function(dt)
        if not S.flyCarro then return end
        if not (bv.Parent and bg.Parent) then return end
        dt = dt or 0.016

        local dir  = direcaoDesejada(true)
        local alvo = dir * S.flyCarroVel

        local peso = S.flySuave
        if dir.Magnitude < 0.01 then peso = S.flyFreio end
        Mov.velCar = Mov.velCar:Lerp(alvo, U.clamp(dt * peso, 0, 1))
        bv.Velocity = Mov.velCar

        -- o carro aponta pra onde voce olha, sem capotar
        local cam = Camera.CFrame
        local frente = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
        if frente.Magnitude > 0.001 then
            local pos = base.Position
            bg.CFrame = bg.CFrame:Lerp(CFrame.new(pos, pos + frente.Unit),
                                       U.clamp(dt * 6, 0, 1))
        end
    end

    P.aviso("fly de carro ligado", "ok")
    return true
end

-- se voce sair do carro, desliga sozinho
Ciclos.coracao["flycar_guarda"] = function()
    if not S.flyCarro then return end
    if not assento() then
        P.setChave("flyCarro", false)
        pararFlyCarro()
        P.aviso("voce saiu do carro, desliguei o fly dele", "atencao", 4)
    end
end

