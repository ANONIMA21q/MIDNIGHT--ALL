-- Se uma funcao dessas der erro, ela e removida sozinha e as outras seguem.
local Ciclos = { coracao = {}, quadro = {}, passo = {} }

local function rodar(tabela, dt)
    for nome, fn in pairs(tabela) do
        local ok, err = pcall(fn, dt)
        if not ok then
            tabela[nome] = nil
            warn("[MIDNIGHT] ciclo '" .. tostring(nome) .. "' desligado: " .. tostring(err))
        end
    end
end

Svc.Run.Heartbeat:Connect(function(dt) rodar(Ciclos.coracao, dt) end)
Svc.Run.RenderStepped:Connect(function(dt) rodar(Ciclos.quadro, dt) end)
Svc.Run.Stepped:Connect(function(_, dt) rodar(Ciclos.passo, dt) end)

