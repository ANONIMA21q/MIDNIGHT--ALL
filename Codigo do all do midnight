local function infoDoAlvo()
    local p = J.alvo
    if not p then return "nenhum alvo escolhido" end
    local h, r = humDe(p), raizDe(p)
    local linhas = {
        ("nome       %s"):format(p.DisplayName),
        ("usuario    @%s"):format(p.Name),
        ("id         %d"):format(p.UserId),
        ("distancia  %s"):format(distDe(p) >= 0 and (distDe(p) .. "m") or "?"),
    }
    if h then
        linhas[#linhas + 1] = ("vida       %d / %d"):format(
            math.floor(h.Health), math.floor(h.MaxHealth))
        linhas[#linhas + 1] = ("velocidade %d"):format(math.floor(h.WalkSpeed))
    end
    if p.Team then linhas[#linhas + 1] = ("time       %s"):format(p.Team.Name) end
    local ok, amigo = pcall(function() return LP:IsFriendsWith(p.UserId) end)
    linhas[#linhas + 1] = ("amigo      %s"):format((ok and amigo) and "sim" or "nao")
    if r then
        linhas[#linhas + 1] = ("altura     %d"):format(math.floor(r.Position.Y))
        linhas[#linhas + 1] = ("parado?    %s"):format(
            (h and h.MoveDirection.Magnitude < 0.1) and "sim" or "nao")
    end
    return table.concat(linhas, "\n")
end

