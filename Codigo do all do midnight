-- 5 · CAIXA PRETA  (grava tudo que aconteceu antes de voce morrer)
--==========================================================================
-- Quando voce morre ou e teleportado, ele guarda os ultimos segundos:
-- quem estava perto, a que velocidade, e o que a protecao reagiu.
-- Serve pra descobrir DEPOIS quem te matou ou te tirou do lugar.
Pro2.caixa = {}

Ciclos.coracao["caixaPreta"] = function()
    if not S.caixaPreta then return end
    if tick() - (Pro2.caixaEm or 0) < 0.5 then return end
    Pro2.caixaEm = tick()

    local r = raiz()
    if not r then return end

    local perto = {}
    for _, p in ipairs(Svc.Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
            if pr then
                local d = (pr.Position - r.Position).Magnitude
                if d < 60 then
                    perto[#perto + 1] = ("%s(%dm)"):format(p.DisplayName, math.floor(d))
                end
            end
        end
    end

    local h = humano()
    Pro2.caixa[#Pro2.caixa + 1] = {
        t    = os.date("%H:%M:%S"),
        vida = h and math.floor(h.Health) or 0,
        vel  = math.floor(r.AssemblyLinearVelocity.Magnitude),
        alt  = math.floor(r.Position.Y),
        gente= table.concat(perto, " "),
    }
    if #Pro2.caixa > 40 then table.remove(Pro2.caixa, 1) end
end

local function despejarCaixa()
    if #Pro2.caixa == 0 then return "nada gravado" end
    local linhas = {}
    for _, e in ipairs(Pro2.caixa) do
        linhas[#linhas + 1] = ("[%s] vida %d · vel %d · altura %d · perto: %s")
            :format(e.t, e.vida, e.vel, e.alt, e.gente ~= "" and e.gente or "ninguem")
    end
    return table.concat(linhas, "\n")
end

