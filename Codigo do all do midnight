Ciclos.quadro["cameraVigia"] = function()
    local h = humano()

    -- Anti Camera Shake
    if S.antiShake and h and h.CameraOffset.Magnitude > 0.05 then
        h.CameraOffset = Vector3.zero
    end

    -- Anti Camera Lock: o jogo forcou primeira pessoa ou travou o modo
    if S.antiCamLock then
        if LP.CameraMode ~= Enum.CameraMode.Classic and not S.freecam then
            LP.CameraMode = Enum.CameraMode.Classic
            anotar("destravaram sua camera")
        end
        if Camera.CameraType == Enum.CameraType.Scriptable and not S.freecam then
            Camera.CameraType = Enum.CameraType.Custom
            if h then Camera.CameraSubject = h end
            anotar("a camera estava sequestrada, devolvi")
        end
    end

    -- Anti Zoom Lock
    if S.antiZoomLock then
        if LP.CameraMaxZoomDistance < S.zoomMinimo then
            LP.CameraMaxZoomDistance = S.zoomMinimo
            anotar("liberaram seu zoom")
        end
        if LP.CameraMinZoomDistance > 2 then LP.CameraMinZoomDistance = 0.5 end
    end

    -- Anti Blur / Anti Flash / Anti Black Screen
    if S.antiTelaSuja then
        for _, e in ipairs(Svc.Lighting:GetChildren()) do
            if e:IsA("BlurEffect") and e.Size > 0 then
                e.Enabled = false
                anotar("tiraram o borrado da sua tela")
            elseif e:IsA("ColorCorrectionEffect") then
                if e.Brightness > 0.4 or e.Brightness < -0.4 then
                    e.Brightness = 0
                    anotar("tiraram o clarao/escuridao da tela")
                end
                if e.TintColor and (e.TintColor.R < 0.35 or e.TintColor.G < 0.35) then
                    e.TintColor = Color3.new(1, 1, 1)
                end
            end
        end
        -- telao preto por cima da interface
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            for _, g in ipairs(pg:GetChildren()) do
                if g:IsA("ScreenGui") and g ~= P.Tela then
                    for _, f in ipairs(g:GetChildren()) do
                        if f:IsA("Frame") and f.Visible
                           and f.BackgroundTransparency < 0.15
                           and f.Size.X.Scale >= 1 and f.Size.Y.Scale >= 1 then
                            f.Visible = false
                            anotar("tapei um telao preto que cobriu sua tela")
                        end
                    end
                end
            end
        end
    end
end

