-- [6.5] PROTECAO AVANCADA
--==========================================================================
-- Cinco coisas que quase ninguem faz. A principal e o ANTI GOTO: em vez de
-- so bloquear, ele DESCOBRE QUEM chegou em cima de voce e te avisa pelo nome.

local Pro2 = {}

Pro2.ultimaPos    = nil
Pro2.tocando      = {}     -- [player] = tempo que encostou em voce
Pro2.chegadas     = {}     -- [player] = quantas vezes apareceu do nada
