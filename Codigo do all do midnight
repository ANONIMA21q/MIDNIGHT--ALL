-- ligar/desligar uma chave e a interface acompanhar sozinha
P.chaves = {}

-- muda o valor E a aparencia da chave, sem disparar a funcao dela
function P.setChave(campo, valor)
    S[campo] = valor and true or false
    local lista = P.chaves[campo]
    if not lista then return end
    for _, pintar in ipairs(lista) do pcall(pintar, S[campo]) end
end

local function registrarChave(campo, pintar)
    if not campo then return end
    P.chaves[campo] = P.chaves[campo] or {}
    table.insert(P.chaves[campo], pintar)
end

