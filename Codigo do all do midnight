        S[campo] = U.clamp((S[campo] or minimo) + dir * passo, minimo, maximo)
        att()
        if fn then pcall(fn, S[campo]) end
    end
    menos.MouseButton1Click:Connect(function() andar(-1) end)
    mais.MouseButton1Click:Connect(function() andar(1) end)
    local function porX(px)
        local x0, larg = barra.AbsolutePosition.X, barra.AbsoluteSize.X
        if larg <= 0 then return end
        local rel = U.clamp((px - x0) / larg, 0, 1)
        S[campo] = U.clamp(math.floor((minimo + (maximo - minimo) * rel) / passo + 0.5) * passo,
                           minimo, maximo)
        att()
        if fn then pcall(fn, S[campo]) end
    end
    area.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
           or i.UserInputType == Enum.UserInputType.Touch then
            arrastando = porX
            paginaArrasto = cx:FindFirstAncestorWhichIsA("ScrollingFrame")
            if paginaArrasto then pcall(function() paginaArrasto.ScrollingEnabled = false end) end
            porX(i.Position.X)
        end
    end)
    att()
    return { att = att }
end

