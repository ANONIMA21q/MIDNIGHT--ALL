-- PINTAR UM ALVO
--==========================================================================
local function pintarAlvo(p, d, dados)
    local c    = p.Character
    local cor1 = corDoAlvo(dados)
    local op   = U.clamp(S.espTransparencia + pulso(), 0, 1)   -- opacidade
    local alt  = dados.altura

    ---------------------------------------------------------------- brilho
    if S.espBrilho then
        d.brilho.Adornee             = c
        d.brilho.FillColor           = cor1
        d.brilho.OutlineColor        = S.espBrilhoContorno and Color3.new(1, 1, 1) or cor1
        d.brilho.FillTransparency    = S.espBrilhoTransp
        d.brilho.OutlineTransparency = 0.08
        d.brilho.DepthMode           = S.espAtravessaParede
                                       and Enum.HighlightDepthMode.AlwaysOnTop
                                       or Enum.HighlightDepthMode.Occluded
        d.brilho.Enabled = true
    else
        d.brilho.Enabled = false
    end

    ---------------------------------------------------------------- caixa
    if S.espCaixa then
        d.caixaGui.Enabled = true
        d.caixaGui.Size    = UDim2.new(alt * 0.62, 0, alt, 0)
        local esp = S.espEspessura

        if S.espEstiloCaixa == 0 then
            for _, b in ipairs(d.cantos) do b.Visible = false end
            local lados = {
                { UDim2.new(1, 0, 0, esp), UDim2.new(0, 0, 0, 0) },
                { UDim2.new(1, 0, 0, esp), UDim2.new(0, 0, 1, -esp) },
                { UDim2.new(0, esp, 1, 0), UDim2.new(0, 0, 0, 0) },
                { UDim2.new(0, esp, 1, 0), UDim2.new(1, -esp, 0, 0) },
            }
            for i, b in ipairs(d.barras) do
                b.Visible                = true
                b.Size                   = lados[i][1]
                b.Position               = lados[i][2]
                b.BackgroundColor3       = cor1
                b.BackgroundTransparency = 1 - op
            end
        else
            for _, b in ipairs(d.barras) do b.Visible = false end
            local t = U.clamp(S.espCantoTam, 0.05, 0.5)
            local defs = {
                { UDim2.new(t, 0, 0, esp), UDim2.new(0, 0, 0, 0),        Vector2.new(0, 0) },
                { UDim2.new(0, esp, t, 0), UDim2.new(0, 0, 0, 0),        Vector2.new(0, 0) },
                { UDim2.new(t, 0, 0, esp), UDim2.new(1, 0, 0, 0),        Vector2.new(1, 0) },
                { UDim2.new(0, esp, t, 0), UDim2.new(1, -esp, 0, 0),     Vector2.new(0, 0) },
                { UDim2.new(t, 0, 0, esp), UDim2.new(0, 0, 1, -esp),     Vector2.new(0, 0) },
                { UDim2.new(0, esp, t, 0), UDim2.new(0, 0, 1, 0),        Vector2.new(0, 1) },
                { UDim2.new(t, 0, 0, esp), UDim2.new(1, 0, 1, -esp),     Vector2.new(1, 0) },
                { UDim2.new(0, esp, t, 0), UDim2.new(1, -esp, 1, 0),     Vector2.new(0, 1) },
            }
            for i, b in ipairs(d.cantos) do
                b.Visible                = true
                b.Size                   = defs[i][1]
                b.Position               = defs[i][2]
                b.AnchorPoint            = defs[i][3]
                b.BackgroundColor3       = cor1
                b.BackgroundTransparency = 1 - op
            end
        end

        d.preenche.Visible                = S.espPreencher
        d.preenche.BackgroundColor3       = cor1
        d.preenche.BackgroundTransparency = S.espPreencheTransp
    else
        d.caixaGui.Enabled = false
    end

    ---------------------------------------------------------------- texto
    local temTexto = S.espNome or S.espDistancia or S.espVidaTexto
                     or S.espVidaPorcento or S.espFerramenta
    if temTexto then
        d.placa.Enabled     = true
        d.placa.StudsOffset = Vector3.new(0, alt * 0.55 + 0.7, 0)

        if S.espNome then
            local nome = dados.nome
            if S.espTime and p.Team then nome = nome .. "  [" .. p.Team.Name .. "]" end
            d.txtNome.Text       = nome
            d.txtNome.TextColor3 = cor1
            d.txtNome.TextSize   = S.espFonte
            d.txtNome.Visible    = true
        else
            d.txtNome.Visible = false
        end

        local baixo = {}
        if S.espDistancia    then baixo[#baixo + 1] = math.floor(dados.dist) .. "m" end
        if S.espVidaTexto    then baixo[#baixo + 1] = math.floor(dados.vida) .. " hp" end
        if S.espVidaPorcento then baixo[#baixo + 1] = math.floor(dados.vidaFrac * 100) .. "%" end
        if #baixo > 0 then
            d.txtInfo.Text       = table.concat(baixo, "  ·  ")
            d.txtInfo.TextColor3 = cor1
            d.txtInfo.TextSize   = math.max(S.espFonte - 2, 8)
            d.txtInfo.Visible    = true
        else
            d.txtInfo.Visible = false
        end

        if S.espFerramenta then
            local f = c and c:FindFirstChildOfClass("Tool")
            d.txtTool.Text    = f and f.Name or ""
            d.txtTool.Visible = f ~= nil
        else
            d.txtTool.Visible = false
        end
    else
        d.placa.Enabled = false
    end

    ---------------------------------------------------------------- vida
    if S.espBarraVida then
        d.vidaGui.Enabled     = true
        d.vidaGui.Size        = UDim2.new(0, 6, alt, 0)
        local lado = (S.espBarraLado == 0) and -1 or 1
        d.vidaGui.StudsOffset = Vector3.new(lado * (alt * 0.36), 0, 0)
        d.vidaBarra.Size      = UDim2.new(1, 0, U.clamp(dados.vidaFrac, 0, 1), 0)
        d.vidaBarra.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
            :Lerp(Color3.fromRGB(235, 60, 60), 1 - dados.vidaFrac)
    else
        d.vidaGui.Enabled = false
    end

    ---------------------------------------------------------------- cabeca
    if S.espCabecaAro then
        local cab = c and c:FindFirstChild("Head")
        if cab then
            d.cabecaGui.Adornee     = cab
            d.cabecaGui.Enabled     = true
            d.cabecaBorda.Color     = cor1
            d.cabecaBorda.Thickness = S.espEspessura
        else
            d.cabecaGui.Enabled = false
        end
    else
        d.cabecaGui.Enabled = false
    end

    ---------------------------------------------------------------- linha
    if S.espTracer then
        local frente = 10
        local meia   = math.tan(math.rad(Camera.FieldOfView * 0.5)) * frente
        local borda  = meia * 0.92          -- quase encostando na borda
        local modo   = S.espTracerDe

        local largura = S.espLinhaEsp * 0.02
        local transp  = NumberSequence.new(U.clamp(1 - op * S.espLinhaOp, 0, 1))
        local luz     = S.espLinhaBrilho and 0.6 or 0
        local corSeq  = ColorSequence.new(cor1)

        local function ligarLinha(beam, att)
            beam.Attachment0   = att
            beam.Attachment1   = d.a1
            beam.Color         = corSeq
            beam.Width0        = largura
            beam.Width1        = largura
            beam.LightEmission = luz
            beam.Transparency  = transp
            beam.Enabled       = true
        end

        -- 0 = baixo | 1 = meio | 2 = cima | 3 = os dois ao mesmo tempo
        local altura1 = -borda
        if modo == 1 then altura1 = 0 elseif modo == 2 then altura1 = borda end
        ligarLinha(d.linha, ancoraEm("p1", altura1, frente).att)

        if modo == 3 then
            ligarLinha(d.linha2, ancoraEm("p2", borda, frente).att)
        else
            d.linha2.Enabled = false
        end
    else
        d.linha.Enabled  = false
        d.linha2.Enabled = false
    end
end

--==========================================================================
-- CICLO
--==========================================================================
Ciclos.coracao["esp"] = function()
    E.quadros = E.quadros + 1
    if tick() - E.fpsHora >= 1 then
        E.fps, E.quadros, E.fpsHora, E.medido = math.max(E.quadros, 1), 0, tick(), true
    end

    if not S.esp then
        if E.ligado then
            for _, d in pairs(E.alvos) do esconder(d) end
            E.ligado = false
        end
        return
    end
    E.ligado = true

    local intervalo = 1 / math.max(S.espTaxa, 1)
    if S.espDesempenho and E.medido and E.fps < S.espFpsMin then
        intervalo = intervalo * 2
    end
    if tick() - E.ultimo < intervalo then return end
    E.ultimo = tick()

    local minhaPos = U.myPos()

    local fila = {}
    for _, p in ipairs(Svc.Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local c = p.Character
            local r = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
            local h = c:FindFirstChildOfClass("Humanoid")
            if r then
                local dist = (r.Position - minhaPos).Magnitude
                if podeMostrar(p, h, dist) then
                    fila[#fila + 1] = { p = p, c = c, r = r, h = h, dist = dist }
                end
            end
        end
    end
    table.sort(fila, function(a, b) return a.dist < b.dist end)

    local limite = S.espLimite
    if S.espDesempenho and E.medido and E.fps < S.espFpsMin then
        limite = math.max(3, math.floor(limite * 0.5))
    end

    local mostrados = {}
    for i, e in ipairs(fila) do
        if i > limite then break end
        mostrados[e.p] = true

        local d = E.alvos[e.p]
        -- respawn troca o personagem: refaz as pecas
        if d and (not d.brilho or not d.brilho.Parent or d.raiz ~= e.r) then
            apagar(d); d = nil; E.alvos[e.p] = nil
        end
        if not d then
            local ok, novoD = pcall(criarPecas, e.p, e.r)
            if ok and novoD then
                novoD.raiz = e.r
                d = novoD
                E.alvos[e.p] = d
            end
        end

        if d then
            local visivel = true
            if S.espChecarVisao or S.espModoCor == 5 then
                local okV, res = pcall(estaVisivel, e.r.Position, e.c)
                visivel = okV and res or true
            end

            if S.espSoVisivel and not visivel then
                esconder(d)
            else
                local vmax = (e.h and e.h.MaxHealth > 0) and e.h.MaxHealth or 100
                local okA, altura = pcall(alturaDoCorpo, e.c)
                local okP, err = pcall(pintarAlvo, e.p, d, {
                    nome = (S.espTipoNome == 0) and e.p.DisplayName
                           or (S.espTipoNome == 1) and e.p.Name
                           or (e.p.DisplayName .. " (@" .. e.p.Name .. ")"),
                    dist = e.dist, vida = e.h and e.h.Health or 0,
                    vidaFrac = e.h and (e.h.Health / vmax) or 1,
                    visivel = visivel, mesmoTime = mesmoTime(e.p),
                    altura = okA and altura or 6, deslocamento = d.deslocamento,
                })
                if not okP then esconder(d) end
            end
        end
    end

    for p, d in pairs(E.alvos) do
        if not mostrados[p] then
            esconder(d)
            if not p.Parent then apagar(d); E.alvos[p] = nil end
        end
    end
end

Svc.Players.PlayerRemoving:Connect(function(p)
    local d = E.alvos[p]
    if d then apagar(d); E.alvos[p] = nil end
end)

