--==========================================================================
-- 1 · ANTI GOTO / ANTI TO  (nao teleportam em cima de voce)
--==========================================================================
-- Como funciona: eu guardo onde cada jogador estava no quadro anterior.
-- Se alguem PULA uma distancia grande e cai perto de voce, foi goto.
-- Dai eu anoto o nome, aviso, e (se voce quiser) te tiro de perto na hora.
Pro2.posAnterior = {}

Ciclos.coracao["antiGoto"] = function()
    if not (S.antiGoto or S.avisarChegada) then return end
    local r = raiz()
    if not r then return end
    local minhaPos = r.Position

    for _, p in ipairs(Svc.Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local pr = p.Character:FindFirstChild("HumanoidRootPart")
                     or p.Character.PrimaryPart
            if pr then
                local agora    = pr.Position
                local anterior = Pro2.posAnterior[p]
                Pro2.posAnterior[p] = agora

                if anterior then
                    local pulo = (agora - anterior).Magnitude
                    local dist = (agora - minhaPos).Magnitude

                    -- pulou muito num quadro so E caiu perto de voce = goto
                    if pulo > S.gotoPulo and dist < S.gotoRaio then
                        Pro2.chegadas[p] = (Pro2.chegadas[p] or 0) + 1

                        if tick() - (Pro2.avisadoEm[p] or 0) > 3 then
                            Pro2.avisadoEm[p] = tick()
                            local msg = ("%s teleportou em cima de voce (%dm)")
                                :format(p.DisplayName, math.floor(dist))
                            P.aviso(msg, "atencao", 5)
                            anotar(msg)
                        end

                        -- reacao: sair de perto
                        if S.antiGoto then
                            if S.gotoReacao == 1 then
                                -- empurrar: sobe e afasta na direcao oposta
                                local fuga = (minhaPos - agora)
                                if fuga.Magnitude < 1 then fuga = Vector3.new(1, 0, 0) end
                                r.CFrame = CFrame.new(minhaPos + fuga.Unit * S.gotoFuga
                                                      + Vector3.new(0, 6, 0))
                                anotar("me afastei de " .. p.DisplayName)
                            elseif S.gotoReacao == 2 then
                                -- voltar pro ultimo lugar seguro
                                if Pro2.posSegura then
                                    r.CFrame = CFrame.new(Pro2.posSegura + Vector3.new(0, 4, 0))
                                    anotar("voltei pro lugar seguro por causa de " .. p.DisplayName)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- guarda o lugar seguro (longe de todo mundo)
    if tick() - (Pro2.checouSeguro or 0) > 2 then
        Pro2.checouSeguro = tick()
        local h = humano()
        if h and h.FloorMaterial ~= Enum.Material.Air then
            local perto = false
            for _, p in ipairs(Svc.Players:GetPlayers()) do
                if p ~= LP then
                    local pr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if pr and (pr.Position - minhaPos).Magnitude < 30 then perto = true; break end
                end
            end
            if not perto then Pro2.posSegura = minhaPos end
        end
    end
end

-- limpa quando alguem sai
Svc.Players.PlayerRemoving:Connect(function(p)
    Pro2.posAnterior[p] = nil
    Pro2.chegadas[p]    = nil
    Pro2.avisadoEm[p]   = nil
