-- executa script
-- Separa BAIXAR de EXECUTAR: assim da pra dizer se o problema foi a URL
-- (link morto, token vencido, repo privado) ou o codigo em si.
local function runScript(entry)
    showStatus("carregando "..entry.name.."...", C.Accent)
    task.spawn(function()
        local okGet, fonte = pcall(function() return game:HttpGet(entry.url) end)
        if not okGet or type(fonte) ~= "string" or #fonte < 10 then
            showStatus("[ erro ] "..entry.name..": link nao respondeu", C.Red)
            return
        end
        -- pagina de erro do GitHub volta como texto curto, nao como codigo
        if fonte:sub(1, 3) == "404" or fonte:find("^Not Found") then
            showStatus("[ erro ] "..entry.name..": link expirado ou repo privado", C.Red)
            return
        end
        local fn, errC = loadstring(fonte)
        if not fn then
            showStatus("[ erro ] "..entry.name..": codigo invalido", C.Red)
            warn("[MIDNIGHT ALL] "..entry.name.." nao compilou: "..tostring(errC))
            return
        end
        local okRun, errR = pcall(fn)
        if okRun then showStatus("[ ok ] "..entry.name.." carregado", C.Green)
        else
            showStatus("[ erro ] "..entry.name..": "..tostring(errR), C.Red)
            warn("[MIDNIGHT ALL] "..entry.name.." deu erro: "..tostring(errR))
        end
    end)
end

-- linha de script com 👉
local function ScriptRow(parent, entry, order)
    local row=Instance.new("Frame",parent); row.Size=UDim2.new(1,0,0,26); row.BackgroundColor3=C.Card; row.BorderSizePixel=0; row.LayoutOrder=order
    corner(row,4); stroke(row,C.Border,1,0.3)
    local nm=Instance.new("TextLabel",row); nm.Size=UDim2.new(1,-70,1,0); nm.Position=UDim2.new(0,10,0,0); nm.BackgroundTransparency=1
    nm.Text=entry.name; nm.Font=Enum.Font.Code; nm.TextSize=13; nm.TextColor3=C.Text; nm.TextXAlignment=Enum.TextXAlignment.Left

    -- etiqueta opcional ao lado do nome (ex.: NOVO)
    -- Fica ancorada a DIREITA, antes do botao: nao depende de TextBounds,
    -- que so tem valor depois que o texto e desenhado.
    if entry.tag then
        nm.Size = UDim2.new(1,-120,1,0)
        local tg=Instance.new("TextLabel",row)
        pcall(function() tg.AutomaticSize=Enum.AutomaticSize.X end)
        tg.Size=UDim2.new(0,38,0,14); tg.Position=UDim2.new(1,-104,0.5,-7)
        tg.BackgroundColor3=C.Accent; tg.BorderSizePixel=0; tg.Text=entry.tag
        tg.Font=Enum.Font.Code; tg.TextSize=10; tg.TextColor3=C.White
        corner(tg,3)
    end

    local go=Instance.new("TextButton",row); go.Size=UDim2.fromOffset(54,20); go.Position=UDim2.new(1,-60,0.5,-10)
    go.AutoButtonColor=false; go.BackgroundColor3=C.Panel; go.BorderSizePixel=0; go.Text="👉"; go.Font=Enum.Font.Code; go.TextSize=14; go.TextColor3=C.Accent
    corner(go,4); stroke(go,C.Accent,1,0.2)
    go.MouseEnter:Connect(function() tw(go,{BackgroundColor3=C.Hover},0.1) end)
    go.MouseLeave:Connect(function() tw(go,{BackgroundColor3=C.Panel},0.1) end)
    go.MouseButton1Click:Connect(function()
        runScript(entry); tw(go,{BackgroundColor3=C.Accent},0.08)
        task.delay(0.2,function() tw(go,{BackgroundColor3=C.Panel},0.14) end)
    end)
end

