E.ultimo, E.fps, E.quadros, E.fpsHora, E.medido = 0, 60, 0, tick(), false

--==========================================================================
-- AJUDANTES
--==========================================================================
local function novo(classe, props, pai)
    local o = Instance.new(classe)
    for k, v in pairs(props) do pcall(function() o[k] = v end) end
    if pai then o.Parent = pai end
    return o
end

local function corDoAlvo(d)
    local m = S.espModoCor
    if m == 1 then
        return Color3.fromHSV(((tick() * S.espArcoVel * 0.1) + d.deslocamento) % 1, 1, 1)
    elseif m == 2 then
        local v = d.vidaFrac or 1
        if v > 0.6 then return Color3.fromRGB(60, 220, 90) end
        if v > 0.3 then return Color3.fromRGB(240, 210, 60) end
        return Color3.fromRGB(235, 60, 60)
    elseif m == 3 then
        if d.dist < S.espPerto then return Color3.fromRGB(235, 70, 70) end
        if d.dist < S.espMedio then return Color3.fromRGB(240, 190, 60) end
        return Color3.fromRGB(90, 190, 255)
    elseif m == 4 then
        return d.mesmoTime and Color3.fromRGB(80, 180, 255) or Color3.fromRGB(235, 70, 70)
    elseif m == 5 then
        if d.visivel then return Color3.fromRGB(S.espVisR, S.espVisG, S.espVisB) end
        return Color3.fromRGB(S.espOcuR, S.espOcuG, S.espOcuB)
    end
    return Color3.fromRGB(S.espCorR, S.espCorG, S.espCorB)
end

local function pulso()
    if not S.espPulso then return 0 end
    return 0.35 * math.abs(math.sin(tick() * S.espPulsoVel))
end

local function ehAmigo(p)
    local ok, r = pcall(function() return LP:IsFriendsWith(p.UserId) end)
    return ok and r or false
end

local function mesmoTime(p)
    if not p.Team or not LP.Team then return false end
    return p.Team == LP.Team
end

local function podeMostrar(p, h, dist)
    if p == LP then return false end
    if S.espDistMax > 0 and dist > S.espDistMax then return false end
    if S.espIgnorarAmigo and ehAmigo(p) then return false end
    if S.espIgnorarTime and mesmoTime(p) then return false end
    if S.espIgnorarMorto and (not h or h.Health <= 0) then return false end
    if S.espIgnorarSentado and h and h.Sit then return false end
    if S.espSoMovendo and h and h.MoveDirection.Magnitude < 0.1 then return false end
    if S.espIgnorarInvisivel then
        local cab = p.Character and p.Character:FindFirstChild("Head")
        if cab and cab.Transparency >= 0.95 then return false end
    end
    return true
end

local function estaVisivel(pos, personagem)
    local par = RaycastParams.new()
    local ok = pcall(function() par.FilterType = Enum.RaycastFilterType.Exclude end)
    if not ok then pcall(function() par.FilterType = Enum.RaycastFilterType.Blacklist end) end
    par.FilterDescendantsInstances = { pers(), personagem }
    local de = Camera.CFrame.Position
    return workspace:Raycast(de, pos - de, par) == nil
end

-- altura do corpo, pra caixa acompanhar quem e alto e quem e baixo
local function alturaDoCorpo(c)
    local cab = c:FindFirstChild("Head")
    local pe  = c:FindFirstChild("LeftFoot") or c:FindFirstChild("Left Leg")
                or c:FindFirstChild("HumanoidRootPart")
    if cab and pe then
        return math.max((cab.Position - pe.Position).Magnitude + 2, 4)
    end
    return 6
end

