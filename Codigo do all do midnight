local function faixasTocando()
    local h = humano()
    if not h then return {} end
    local alvos = { h:FindFirstChildOfClass("Animator"), h }
    for _, o in ipairs(alvos) do
        if o then
            local ok, lista = pcall(function() return o:GetPlayingAnimationTracks() end)
            if ok and type(lista) == "table" and #lista > 0 then return lista end
        end
    end
    return {}
end

