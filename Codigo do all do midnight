        S.espCaixa, S.espEstiloCaixa, S.espEspessura = true, 1, 2
        S.espNome, S.espDistancia, S.espBarraVida = true, true, true
        S.espTracer, S.espBrilho, S.espPreencher, S.espPulso = false, false, false, false
