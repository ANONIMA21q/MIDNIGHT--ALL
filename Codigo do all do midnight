-- limpeza de efeito pesado (fumaca, fogo, explosao, particula)
local function limparEfeitos(oQue)
    local n = 0
    local ok, lista = pcall(function() return workspace:GetDescendants() end)
    if not ok then return 0 end
    for i, inst in ipairs(lista) do
        if i > 20000 then break end
        local bate = false
        if oQue == "fumaca" and (inst:IsA("Smoke") or inst:IsA("Fire")) then bate = true end
        if oQue == "particula" and (inst:IsA("ParticleEmitter") or inst:IsA("Trail")
           or inst:IsA("Sparkles") or inst:IsA("Explosion")) then
            if inst.Name ~= "MN_Rastro" then bate = true end
        end
        if bate then
            pcall(function() inst:Destroy() end)
            n = n + 1
        end
    end
    return n
end

