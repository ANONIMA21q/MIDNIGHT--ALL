local function entrarEm(jobId, texto)
    if not jobId or jobId == "" then
        P.aviso("id do servidor vazio", "erro"); return
    end
    if jobId == game.JobId then
        P.aviso("voce ja esta nesse servidor", "atencao"); return
    end
    marcarVisitado(game.JobId)
    P.aviso(texto or "entrando no servidor...", "ok", 6)
    local ok = pcall(function()
        Svc.Teleport:TeleportToPlaceInstance(game.PlaceId, jobId, LP)
    end)
    if not ok then P.aviso("o teleporte foi recusado", "erro", 6) end
end

