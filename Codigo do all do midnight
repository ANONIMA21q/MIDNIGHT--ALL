    local rot = Instance.new("TextLabel")
    rot.Name, rot.Size, rot.Position = "Rotulo", UDim2.new(1, -36, 1, 0), UDim2.new(0, 32, 0, 0)
    rot.BackgroundTransparency, rot.Font, rot.TextSize = 1, Enum.Font.GothamMedium, 11
    rot.TextColor3, rot.TextXAlignment = T.apagado, Enum.TextXAlignment.Left
    rot.Text, rot.ZIndex, rot.Parent = nome, 4, bt

    P.abas[nome] = bt

    -- pagina: rolagem com 2 colunas de cartoes
    local pg = Instance.new("ScrollingFrame")
    pg.Name, pg.Size = nome, UDim2.new(1, 0, 1, 0)
    pg.BackgroundTransparency, pg.BorderSizePixel = 1, 0
    pg.ScrollBarThickness, pg.ScrollBarImageColor3 = 4, cor()
    pg.CanvasSize, pg.Visible, pg.ZIndex = UDim2.new(0, 0, 0, 0), false, 1
    pg.Parent = Conteudo
    margem(pg, 0, 10, 0, 14)

    -- duas colunas lado a lado, cada uma empilhando cartoes
    local colunas = Instance.new("Frame")
    colunas.Size, colunas.BackgroundTransparency = UDim2.new(1, 0, 0, 0), 1
    colunas.AutomaticSize = Enum.AutomaticSize.Y
    colunas.Parent = pg

    local esq = Instance.new("Frame")
    esq.Name, esq.Size = "Esq", UDim2.new(0.5, -5, 0, 0)
    esq.Position, esq.BackgroundTransparency = UDim2.new(0, 0, 0, 0), 1
    esq.AutomaticSize, esq.Parent = Enum.AutomaticSize.Y, colunas
    local lEsq = Instance.new("UIListLayout")
    lEsq.Padding, lEsq.SortOrder = UDim.new(0, 8), Enum.SortOrder.LayoutOrder
    lEsq.Parent = esq

    local dir = Instance.new("Frame")
    dir.Name, dir.Size = "Dir", UDim2.new(0.5, -5, 0, 0)
    dir.Position, dir.BackgroundTransparency = UDim2.new(0.5, 5, 0, 0), 1
    dir.AutomaticSize, dir.Parent = Enum.AutomaticSize.Y, colunas
    local lDir = Instance.new("UIListLayout")
    lDir.Padding, lDir.SortOrder = UDim.new(0, 8), Enum.SortOrder.LayoutOrder
    lDir.Parent = dir

    -- canvas acompanha a coluna mais alta
    local function attCanvas()
        local h = math.max(lEsq.AbsoluteContentSize.Y, lDir.AbsoluteContentSize.Y)
        pg.CanvasSize = UDim2.new(0, 0, 0, h + 24)
    end
    lEsq:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(attCanvas)
    lDir:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(attCanvas)
    task.defer(attCanvas)

    local dados = {
        frame = pg, esq = esq, dir = dir,
        lEsq = lEsq, lDir = lDir, colunas = colunas,
        nCartoes = 0, cartoes = {},
        umaColuna = false,
    }
    P.pags[nome] = dados

    bt.MouseButton1Click:Connect(function() P.mostrar(nome) end)
    return dados
end

