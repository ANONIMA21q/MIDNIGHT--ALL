local function montarESP()
    local pg = P.aba("ESP", "Personagem", "◉")

    P.texto(cDiag, "Tudo aqui e objeto do proprio Roblox (Highlight e BillboardGui), entao funciona em qualquer executor - inclusive nos que criam Drawing mas nao desenham na tela.")

    local cDiag = P.cartao(pg, "Estado", "i")
    local diag = P.quadro(cDiag, 58)
    local ultDiag = 0
    Ciclos.coracao["espDiag"] = function()
        if tick() - ultDiag < 1 then return end
        ultDiag = tick()
        if P.atual ~= "ESP" or not P.Janela.Visible then return end
        local n = 0
        for _ in pairs(E.alvos) do n = n + 1 end
        diag.set(("alvos marcados   %d\nfps              %s\noutros jogadores %d")
            :format(n, E.medido and tostring(E.fps) or "medindo...",
