-- copia o avatar do alvo (corpo, cabeca, cor, roupa, acessorio)
local function copiarAvatar()
    local p = J.alvo
    if not p then P.aviso("escolha um alvo", "atencao"); return end
    local meuH, meuC = humano(), pers()
    if not (meuH and meuC) then P.aviso("seu personagem nao carregou", "erro"); return end

    -- 1) descricao vinda do perfil (mais completa)
    local ok1, desc = pcall(function()
        return Svc.Players:GetHumanoidDescriptionFromUserId(p.UserId)
    end)
    if ok1 and desc and pcall(function() meuH:ApplyDescription(desc) end) then
        P.aviso("avatar copiado do perfil (so voce ve)", "ok", 5); return
    end

    -- 2) descricao do personagem em jogo
    local alvoH = humDe(p)
    if alvoH then
        local ok2, d2 = pcall(function() return alvoH:GetAppliedDescription() end)
        if ok2 and d2 and pcall(function() meuH:ApplyDescription(d2) end) then
            P.aviso("avatar copiado do jogo (so voce ve)", "ok", 5); return
        end
    end

    -- 3) na unha
    local alvoC = p.Character
    if not alvoC then P.aviso("alvo sem personagem", "erro"); return end
    for _, o in ipairs(meuC:GetChildren()) do
        if o:IsA("Accessory") or o:IsA("Hat") or o:IsA("Shirt") or o:IsA("Pants")
           or o:IsA("ShirtGraphic") or o:IsA("CharacterMesh") or o:IsA("BodyColors") then
            pcall(function() o:Destroy() end)
        end
    end
    local n = 0
    for _, o in ipairs(alvoC:GetChildren()) do
        if o:IsA("Accessory") or o:IsA("Hat") then
            local cl = o:Clone()
            if not pcall(function() meuH:AddAccessory(cl) end) then
                pcall(function() cl.Parent = meuC end)
            end
            n = n + 1
        elseif o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic")
               or o:IsA("CharacterMesh") or o:IsA("BodyColors") then
            pcall(function() o:Clone().Parent = meuC end); n = n + 1
        end
    end
    for _, tp in ipairs(alvoC:GetChildren()) do
        if tp:IsA("BasePart") then
            local mp = meuC:FindFirstChild(tp.Name)
            if mp and mp:IsA("BasePart") then pcall(function() mp.Color = tp.Color end) end
        end
    end
    P.aviso(("copiei %d pecas na unha (so voce ve)"):format(n), "ok", 5)
end

