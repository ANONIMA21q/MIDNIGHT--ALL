local function ligarRastro(on)
    local c = pers()
    if not c then return end
    local r = raiz()
    if not r then return end

    local velho = r:FindFirstChild("MN_Rastro")
    if velho then pcall(function() velho:Destroy() end) end
    for _, nome in ipairs({ "MN_A1", "MN_A2" }) do
        local a = r:FindFirstChild(nome)
        if a then pcall(function() a:Destroy() end) end
    end
    if not on then return end

    local a1 = Instance.new("Attachment")
    a1.Name     = "MN_A1"
    a1.Position = Vector3.new(0, 1.4, 0)
    a1.Parent   = r
    local a2 = Instance.new("Attachment")
    a2.Name     = "MN_A2"
    a2.Position = Vector3.new(0, -1.4, 0)
    a2.Parent   = r

    local t = Instance.new("Trail")
    t.Name        = "MN_Rastro"
    t.Attachment0 = a1
    t.Attachment1 = a2
    t.Lifetime    = 0.7
    t.LightEmission = 1
    t.Transparency = NumberSequence.new(0.15, 1)
    t.Color       = ColorSequence.new(cor())
    t.Parent      = r
end

