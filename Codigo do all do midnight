local Pro = {}

Pro.guardado   = {}      -- valores bons, tirados quando o personagem nasce
Pro.reacoes    = 0       -- quantas vezes o vigia devolveu algo
Pro.ultimoAlvo = nil     -- quem chegou voando em cima de voce
