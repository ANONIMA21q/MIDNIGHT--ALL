function P.aplicarTema()
    local c = cor()
    BordaJanela.Color, Emblema.BackgroundColor3 = c, c
    Bolha.TextColor3, BordaBolha.Color = c, c
    Lateral.ScrollBarImageColor3, Escala.Scale = c, S.escala
    if P.atualizarBinds then pcall(P.atualizarBinds) end
    for _, d in ipairs(Tela:GetDescendants()) do
        if d.Name == "PadBorda" then d.Color = c end
        if d.Name == "PadBotao" then d.TextColor3 = c end
        if d.Name == "Cheio" or d.Name == "IconeCartao" or d.Name == "Marca" then
            if d:IsA("TextLabel") then d.TextColor3 = c else d.BackgroundColor3 = c end
        end
        if d.Name == "CaixaIcone" then d.BackgroundColor3 = c end
    end
    -- a lateral repinta pelo proprio P.mostrar, que sabe o estilo novo
    if P.atual then pcall(P.mostrar, P.atual) end
    for _, pg in pairs(P.pags) do pg.frame.ScrollBarImageColor3 = c end
    pcall(P.aplicarVidro)
end

function P.salvarCfg()
    local out = {}
    for k, v in pairs(S) do
        if not NAO_SALVAR[k] then
            local t = type(v)
            if t == "number" or t == "string" or t == "boolean" then out[k] = v
            elseif k == "binds" and t == "table" then out[k] = v end
        end
    end
    if U.jsonWrite(ARQ_CFG, out) then aviso("configuracao salva", "ok")
    else aviso("seu executor nao deixa salvar arquivo", "erro") end
end

function P.carregarCfg()
    local t = U.jsonRead(ARQ_CFG, nil)
    if not t then aviso("nenhuma configuracao salva", "atencao"); return end
    for k, v in pairs(t) do
        if S[k] ~= nil and not NAO_SALVAR[k] then S[k] = v end
    end
    if type(t.binds) == "table" then S.binds = t.binds end
    P.aplicarTema()
    if P.atualizarBinds then pcall(P.atualizarBinds) end
    aviso("configuracao carregada", "ok")
end
