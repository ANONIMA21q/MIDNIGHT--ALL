-- Na referencia as opcoes de DENTRO do cartao sao quadradinhos de marcar
-- (checkbox), nao interruptores, e a linha nao tem caixa em volta.
function P.chave(cx, txt, campo, fn, idBind)
    local b = Instance.new("TextButton")
    b.Size, b.BackgroundTransparency = UDim2.new(1, 0, 0, 26), 1
    b.BorderSizePixel, b.Text, b.AutoButtonColor = 0, "", false
    b.LayoutOrder, b.Parent = proxOrdem(), cx

    local cxq = Instance.new("Frame")
    cxq.Size, cxq.Position = UDim2.new(0, 15, 0, 15), UDim2.new(0, 4, 0.5, -7.5)
    cxq.BackgroundColor3, cxq.BackgroundTransparency = Color3.fromRGB(58, 58, 74), 0
    cxq.BorderSizePixel, cxq.Parent = 0, b
    canto(cxq, 4)
    local bordaQ = borda(cxq, Color3.fromRGB(86, 86, 106), 1, 0.35)

    local tique = Instance.new("TextLabel")
    tique.Size, tique.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    tique.Font, tique.TextSize = Enum.Font.GothamBold, 12
    tique.TextColor3, tique.Text = Color3.new(1, 1, 1), "✓"
    tique.TextTransparency, tique.Parent = 1, cxq

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, idBind and -78 or -28, 1, 0)
    l.Position, l.BackgroundTransparency = UDim2.new(0, 26, 0, 0), 1
    l.Font, l.TextSize, l.TextColor3 = Enum.Font.Gotham, 11, T.apagado
    l.TextXAlignment, l.TextWrapped, l.Text, l.Parent = Enum.TextXAlignment.Left, true, txt, b

    local function pintar(on)
        local ti = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
        Svc.Tween:Create(cxq, ti, {
            BackgroundColor3 = on and cor() or Color3.fromRGB(58, 58, 74) }):Play()
        Svc.Tween:Create(tique, ti, { TextTransparency = on and 0 or 1 }):Play()
        bordaQ.Transparency = on and 1 or 0.35
        l.TextColor3 = on and T.texto or T.apagado
    end
    pintar(campo and S[campo] or false)
    registrarChave(campo, pintar)

    b.MouseButton1Click:Connect(function()
        local v = not (campo and S[campo] or false)
        if campo then S[campo] = v end
        pintar(v)
        if fn then
            local ok, err = pcall(fn, v)
            if not ok then P.aviso("erro em " .. txt .. ": " .. tostring(err), "erro", 6) end
        end
    end)

    local api = { set = function(v) if campo then S[campo] = v end; pintar(v) end }
    if idBind then
        P.bindAcoes[idBind] = function()
            local v = not (campo and S[campo] or false)
            if campo then S[campo] = v end
            pintar(v)
            if fn then pcall(fn, v) end
            P.aviso(txt .. (v and "  ligado" or "  desligado"), v and "ok" or "atencao", 2)
        end
        P.caixaTecla(b, idBind, txt)
    end
    return api
end

