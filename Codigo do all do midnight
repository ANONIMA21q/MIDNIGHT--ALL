local function seguir(on)
    Ciclos.coracao["seguir"] = nil
    if not on then return end
    Ciclos.coracao["seguir"] = function()
        if not S.seguir then return end
        local h, r, me = humano(), raizDe(J.alvo), raiz()
        if not (h and r and me) then return end
        local d = (me.Position - r.Position).Magnitude
        if d > S.seguirDist then
            if S.seguirTp and d > S.seguirDist * 6 then
                me.CFrame = CFrame.new(r.Position - r.CFrame.LookVector * S.seguirDist)
            else
                h:MoveTo(r.Position)
            end
        end
    end
end

local function orbitar(on)
    Ciclos.coracao["orbitar"] = nil
    if not on then return end
    local ang = 0
    Ciclos.coracao["orbitar"] = function(dt)
        if not S.orbitar then return end
        local r, me = raizDe(J.alvo), raiz()
        if not (r and me) then return end
        ang = ang + (dt or 0.016) * S.orbitaVel
        local off = Vector3.new(math.cos(ang) * S.orbitaRaio, S.orbitaAlt,
                                math.sin(ang) * S.orbitaRaio)
        me.CFrame = CFrame.new(r.Position + off, r.Position)
    end
end

