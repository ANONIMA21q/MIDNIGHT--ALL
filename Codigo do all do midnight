--==========================================================================
-- [6.3] ESPECIAIS DE MOVIMENTO
--==========================================================================
-- Coisas que quase nenhum painel tem. Tudo funciona em qualquer jogo porque
-- so mexe no SEU personagem - e como a sua posicao replica, os outros veem.

Mov.historia   = {}      -- ultimos segundos de posicao (pro rebobinar)
Mov.rebobinando= false
Mov.ultimoDash = 0
Mov.ultimoVault= 0
Mov.macro      = {}      -- caminho gravado
Mov.macroGrav  = false
Mov.macroTocar = false
Mov.corda      = nil
Mov.marcadores = {}

local ARQ_MACRO = "midnight_macro.json"

----------------------------------------------------------------- ajudantes
local function raioParams()
    local p = RaycastParams.new()
    local ok = pcall(function() p.FilterType = Enum.RaycastFilterType.Exclude end)
    if not ok then pcall(function() p.FilterType = Enum.RaycastFilterType.Blacklist end) end
    local lista = { pers() }
    for _, m in pairs(Mov.marcadores) do lista[#lista + 1] = m end
    if Mov.corda then lista[#lista + 1] = Mov.corda end
    p.FilterDescendantsInstances = lista
    return p
end

local function vetorTexto(v) return ("%.1f,%.1f,%.1f"):format(v.X, v.Y, v.Z) end

local function textoVetor(t)
    if not t or t == "" then return nil end
    local x, y, z = string.match(t, "([^,]+),([^,]+),([^,]+)")
    if not x then return nil end
    return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
end

--==========================================================================
-- 1 · REBOBINAR  (voltar no tempo)
--==========================================================================
-- Guarda onde voce esteve nos ultimos segundos e desfaz o caminho de tras
-- pra frente. Caiu num buraco, levou fling, entrou onde nao devia: rebobina.
Ciclos.coracao["historia"] = function()
    if Mov.rebobinando then return end
    local r = raiz()
    if not r then return end
    local agora = tick()
    Mov.historia[#Mov.historia + 1] = { cf = r.CFrame, t = agora }
    while #Mov.historia > 0 and (agora - Mov.historia[1].t) > S.rewindSegs do
        table.remove(Mov.historia, 1)
    end
end

local function rebobinar()
    if Mov.rebobinando then return end
    if #Mov.historia < 5 then P.aviso("ainda nao tenho caminho gravado", "atencao"); return end
    local r, h = raiz(), humano()
    if not r then return end

    Mov.rebobinando = true
    if h then pcall(function() h.PlatformStand = true end) end
    P.aviso("rebobinando " .. tostring(math.floor(S.rewindSegs)) .. "s", "ok", 2)

    task.spawn(function()
        local passo = math.max(1, math.floor(S.rewindVel))
        local i = #Mov.historia
        while i > 1 and Mov.rebobinando do
            local r2 = raiz()
            if not r2 then break end
            pcall(function()
                r2.CFrame = Mov.historia[i].cf
                r2.AssemblyLinearVelocity  = Vector3.zero
                r2.AssemblyAngularVelocity = Vector3.zero
            end)
            i = i - passo
            Svc.Run.Heartbeat:Wait()
        end
        local h2 = humano()
        if h2 then pcall(function() h2.PlatformStand = false end) end
        Mov.historia   = {}
        Mov.rebobinando = false
    end)
end

--==========================================================================
-- 2 · GANCHO  (puxa voce pro ponto que estiver mirando)
--==========================================================================
local function tirarCorda()
    Ciclos.quadro["corda"] = nil
    if Mov.corda then pcall(function() Mov.corda:Destroy() end); Mov.corda = nil end
end

local function lancarGancho()
    local r = raiz()
    if not r then return end

    local origem = Camera.CFrame.Position
    local hit = workspace:Raycast(origem, Camera.CFrame.LookVector * S.ganchoAlc, raioParams())
    if not hit then
        P.aviso("nao tem nada na mira ate " .. tostring(math.floor(S.ganchoAlc)) .. "m", "atencao", 3)
        return
    end
    local destino = hit.Position

    -- corda visual (so voce ve, e so enfeite)
    tirarCorda()
    local corda = Instance.new("Part")
    corda.Name         = "MN_Corda"
    corda.Anchored     = true
    corda.CanCollide   = false
    corda.CanQuery     = false
    corda.Material     = Enum.Material.Neon
    corda.Color        = cor()
    corda.Size         = Vector3.new(0.18, 0.18, 1)
    corda.Parent       = workspace
    Mov.corda = corda

    Ciclos.quadro["corda"] = function()
        local r2 = raiz()
        if not (r2 and corda.Parent) then return end
        local de   = r2.Position
        local dist = (destino - de).Magnitude
        corda.Size   = Vector3.new(0.18, 0.18, dist)
        corda.CFrame = CFrame.new(de:Lerp(destino, 0.5), destino)
    end

    -- puxao
    local bv = Instance.new("BodyVelocity")
    bv.Name     = "MN_Gancho"
    bv.MaxForce = Vector3.new(1, 1, 1) * 9e4
    bv.P        = 4000
    bv.Parent   = r

    task.spawn(function()
        local inicio = tick()
        while tick() - inicio < 4 do
            local r2 = raiz()
            if not (r2 and bv.Parent) then break end
            local delta = destino - r2.Position
            local dist  = delta.Magnitude
            if dist < 8 then break end
            -- puxa na direcao do ponto, com um empurrao pra cima pra nao raspar no chao
            bv.Velocity = delta.Unit * S.ganchoVel + Vector3.new(0, 12, 0)
            Svc.Run.Heartbeat:Wait()
        end
        pcall(function() bv:Destroy() end)
        local r3 = raiz()
        if r3 then pcall(function() r3.AssemblyLinearVelocity = Vector3.zero end) end
        task.wait(0.15)
        tirarCorda()
    end)
end

--==========================================================================
-- 3 · DASH  (arranco com fantasmas pra tras)
--==========================================================================
local function fantasma()
    local c = pers()
    if not c then return end
    local modelo = Instance.new("Model")
    modelo.Name = "MN_Fantasma"

    local n = 0
    for _, p in ipairs(c:GetChildren()) do
        if p:IsA("BasePart") and n < 16 then
            n = n + 1
            local cl = p:Clone()
            cl:ClearAllChildren()
            cl.Anchored     = true
            cl.CanCollide   = false
            cl.CanQuery     = false
            cl.Material     = Enum.Material.Neon
            cl.Color        = cor()
            cl.Transparency = 0.5
            cl.Parent       = modelo
        end
    end
    modelo.Parent = workspace

    task.spawn(function()
        for _, p in ipairs(modelo:GetChildren()) do
            pcall(function()
                Svc.Tween:Create(p, TweenInfo.new(0.5), { Transparency = 1 }):Play()
            end)
        end
        task.wait(0.6)
        pcall(function() modelo:Destroy() end)
    end)
end

local function dash()
    if tick() - Mov.ultimoDash < S.dashEspera then
        local falta = S.dashEspera - (tick() - Mov.ultimoDash)
        P.aviso(("espera %.1fs"):format(falta), "atencao", 1.5)
        return
    end
    local r, h = raiz(), humano()
    if not (r and h) then return end
    Mov.ultimoDash = tick()

    local dir = h.MoveDirection
    if dir.Magnitude < 0.1 then dir = Camera.CFrame.LookVector end
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.01 then return end
    dir = dir.Unit

    local bv = Instance.new("BodyVelocity")
    bv.Name     = "MN_Dash"
    bv.MaxForce = Vector3.new(1, 0, 1) * 9e4
    bv.Velocity = dir * S.dashForca
    bv.P        = 6000
    bv.Parent   = r

    task.spawn(function()
        local fim = tick() + S.dashTempo
        while tick() < fim do
            if S.dashFantasma then fantasma() end
            task.wait(0.05)
        end
        pcall(function() bv:Destroy() end)
    end)
end

--==========================================================================
-- 4 · PARKOUR AUTOMATICO  (sobe sozinho no que der pra subir)
--==========================================================================
Ciclos.coracao["parkour"] = function()
    if not S.parkour then return end
    if Mov.rebobinando or S.fly then return end
    local h, r = humano(), raiz()
    if not (h and r) then return end
    if h.MoveDirection.Magnitude < 0.15 then return end
    if tick() - Mov.ultimoVault < 0.55 then return end

    local dir = h.MoveDirection.Unit
    local par = raioParams()

    -- tem parede na altura do peito?
    local peito = workspace:Raycast(r.Position, dir * 3.2, par)
    if not peito then return end

    -- e acima dela esta livre?
    local acima = workspace:Raycast(r.Position + Vector3.new(0, S.parkourAltura, 0),
                                    dir * 3.6, par)
    if acima then return end

    -- tem chao pra pousar do outro lado?
    local frente = r.Position + Vector3.new(0, S.parkourAltura, 0) + dir * 3.2
    local chao   = workspace:Raycast(frente, Vector3.new(0, -S.parkourAltura - 2, 0), par)
    if not chao then return end

    Mov.ultimoVault = tick()
    r.CFrame = CFrame.new(chao.Position + Vector3.new(0, 3.2, 0)) * CFrame.Angles(0, 0, 0)
    r.AssemblyLinearVelocity = dir * 12
end

--==========================================================================
-- 5 · MACRO DE CAMINHO  (grava seu trajeto e repete sozinho)
--==========================================================================
local function macroGravar(on)
    Ciclos.coracao["macroGrav"] = nil
    Mov.macroGrav = on
    if not on then
        P.aviso(("caminho gravado: %d pontos"):format(#Mov.macro), "ok", 4)
        return
    end
    Mov.macro = {}
    local ultimo = 0
    Ciclos.coracao["macroGrav"] = function()
        if not Mov.macroGrav then return end
        if tick() - ultimo < 0.12 then return end
        ultimo = tick()
        local r = raiz()
        if not r then return end
        local p = r.Position
        Mov.macro[#Mov.macro + 1] = { p.X, p.Y, p.Z }
        if #Mov.macro > 1500 then
            Mov.macroGrav = false
            Ciclos.coracao["macroGrav"] = nil
            P.aviso("caminho ficou grande demais, parei de gravar", "atencao", 5)
        end
    end
    P.aviso("gravando o caminho - ande por onde quiser", "ok", 4)
end

local function macroTocar(on)
    Ciclos.coracao["macroTocar"] = nil
    Mov.macroTocar = on
    if not on then return end
    if #Mov.macro < 3 then
        P.aviso("nenhum caminho gravado ainda", "erro")
        P.setChave("macroTocando", false)
        return
    end

    local i = 1
    Ciclos.coracao["macroTocar"] = function(dt)
        if not Mov.macroTocar then return end
        local h, r = humano(), raiz()
        if not (h and r) then return end

        local ponto = Mov.macro[i]
        if not ponto then
            if S.macroLoop then
                i = 1
            else
                Mov.macroTocar = false
                P.setChave("macroTocando", false)
                P.aviso("caminho terminado", "ok")
            end
            return
        end

        local alvo = Vector3.new(ponto[1], ponto[2], ponto[3])
        local d    = (alvo - r.Position).Magnitude

        if d < 4 then
            i = i + math.max(1, math.floor(S.macroVel))
        else
            h:MoveTo(alvo)
            -- se travar num obstaculo, pula o ponto
            if d > 60 then i = i + 1 end
        end
    end
    P.aviso(("repetindo caminho de %d pontos"):format(#Mov.macro), "ok", 4)
end

--==========================================================================
-- 6 · PORTAIS  (dois pontos e um botao pra pular entre eles)
--==========================================================================
local function marcador(nome, pos, corLuz)
    if Mov.marcadores[nome] then
        pcall(function() Mov.marcadores[nome]:Destroy() end)
    end
    local p = Instance.new("Part")
    p.Name         = "MN_Portal_" .. nome
    p.Anchored     = true
    p.CanCollide   = false
    p.CanQuery     = false
    p.Material     = Enum.Material.Neon
    p.Color        = corLuz
    p.Transparency = 0.35
    p.Size         = Vector3.new(3, 0.4, 3)
    p.Position     = pos - Vector3.new(0, 2.6, 0)
    p.Parent       = workspace
    Mov.marcadores[nome] = p

    local luz = Instance.new("PointLight")
    luz.Color     = corLuz
    luz.Range     = 14
    luz.Brightness = 2
    luz.Parent    = p
end

local function marcarPortal(qual)
    local r = raiz()
    if not r then return end
    local txt = vetorTexto(r.Position)
    if qual == "A" then
        S.portalA = txt
        marcador("A", r.Position, Color3.fromRGB(90, 180, 255))
    else
        S.portalB = txt
        marcador("B", r.Position, Color3.fromRGB(255, 130, 90))
    end
    P.aviso("portal " .. qual .. " marcado aqui", "ok", 3)
end

local function irPortal(qual)
    local v = textoVetor(qual == "A" and S.portalA or S.portalB)
    if not v then P.aviso("portal " .. qual .. " nao foi marcado", "atencao"); return end
    local r = raiz()
    if r then r.CFrame = CFrame.new(v + Vector3.new(0, 3, 0)) end
end

-- pula pro portal mais LONGE (e o que faz sentido pra ir e voltar)
local function alternarPortal()
    local a, b = textoVetor(S.portalA), textoVetor(S.portalB)
    local r = raiz()
    if not r then return end
    if not (a or b) then P.aviso("marque os portais primeiro", "atencao"); return end
    if a and not b then r.CFrame = CFrame.new(a + Vector3.new(0, 3, 0)); return end
    if b and not a then r.CFrame = CFrame.new(b + Vector3.new(0, 3, 0)); return end
    local da = (r.Position - a).Magnitude
    local db = (r.Position - b).Magnitude
    local destino = (da > db) and a or b
    r.CFrame = CFrame.new(destino + Vector3.new(0, 3, 0))
end

