local U = {}

function U.clamp(v, a, b) return math.max(a, math.min(b, v)) end

function U.short(txt, n)
    txt = tostring(txt)
    if #txt <= n then return txt end
    return string.sub(txt, 1, n - 2) .. ".."
end

-- onde pendurar a interface (varia por executor)
function U.guiParent()
    if gethui then
        local ok, r = pcall(gethui)
        if ok and r then return r end
    end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then return cg end
    return LP:WaitForChild("PlayerGui")
end

function U.clip(txt)
    local fn = setclipboard or toclipboard or (syn and syn.setclipboard)
    if fn then return (pcall(fn, txt)) end
    return false
end

function U.write(file, txt)
    if writefile then return (pcall(writefile, file, txt)) end
    return false
end

function U.read(file)
    if isfile and readfile then
        local ok, has = pcall(isfile, file)
        if ok and has then
            local ok2, d = pcall(readfile, file)
            if ok2 then return d end
        end
    end
    return nil
end

function U.jsonRead(file, fallback)
    local d = U.read(file)
    if not d then return fallback end
    local ok, t = pcall(function() return Svc.Http:JSONDecode(d) end)
    if ok and type(t) == "table" then return t end
    return fallback
end

function U.jsonWrite(file, tbl)
    local ok, txt = pcall(function() return Svc.Http:JSONEncode(tbl) end)
    if not ok then return false end
    return U.write(file, txt)
end

-- HTTP que tenta todos os jeitos que existem de executor
function U.httpGet(url)
    local tries = {
        function() return game:HttpGet(url) end,
        function() return game:HttpGetAsync(url) end,
        function()
            local req = (syn and syn.request) or http_request or request
                        or (fluxus and fluxus.request)
            if not req then return nil end
            local r = req({ Url = url, Method = "GET" })
            return r and (r.Body or r.body)
        end,
    }
    for _, fn in ipairs(tries) do
        local ok, res = pcall(fn)
        if ok and type(res) == "string" and #res > 2 then return res end
    end
    return nil
end

function U.httpJson(url)
    local body = U.httpGet(url)
    if not body then return nil, "sem resposta do servidor" end
    local ok, data = pcall(function() return Svc.Http:JSONDecode(body) end)
    if not ok then return nil, "resposta estranha" end
    return data
end

-- posicao do meu personagem (Vector3 zero se nao carregou)
function U.myPos()
    local c = LP.Character
    local r = c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
    return r and r.Position or Vector3.new()
end

function U.ping()
    local p = 0
    pcall(function()
        p = math.floor(Svc.Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    return p
end

function U.timeTxt(secs)
    secs = math.floor(secs)
    local h = math.floor(secs / 3600)
    local m = math.floor((secs % 3600) / 60)
    local s = secs % 60
    if h > 0 then return ("%dh %02dm"):format(h, m) end
    if m > 0 then return ("%dm %02ds"):format(m, s) end
    return ("%ds"):format(s)
end

