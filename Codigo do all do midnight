local function ligarFreecam(on)
    Ciclos.quadro["freecam"] = nil
    local r = raiz()
    if on then
        if r then pcall(function() r.Anchored = true end) end
        Camera.CameraType = Enum.CameraType.Scriptable
        Mov.velCam = Vector3.zero
        Ciclos.quadro["freecam"] = function(dt)
            if not S.freecam then return end
            dt = dt or 0.016
            local dir  = direcaoDesejada(true)
            local alvo = dir * S.freecamVel
            local peso = (dir.Magnitude < 0.01) and S.flyFreio or S.freecamSuave
            Mov.velCam = Mov.velCam:Lerp(alvo, U.clamp(dt * peso, 0, 1))
            Camera.CFrame = Camera.CFrame + (Mov.velCam * dt)
        end
        P.aviso("freecam ligada - personagem travado", "ok", 3)
    else
        if r then pcall(function() r.Anchored = false end) end
        Camera.CameraType = Enum.CameraType.Custom
        local h = humano()
        if h then Camera.CameraSubject = h end
    end
end

